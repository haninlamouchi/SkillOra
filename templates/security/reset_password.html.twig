{% extends 'frontoffice/base.html.twig' %}

{% block title %}Nouveau mot de passe - Skillora{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .login-section {
            padding: 110px 0 60px 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .form-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 40px rgba(193,6,9,0.15);
            padding: 40px;
            max-width: 550px;
            margin: 0 auto;
            border-top: 5px solid #c10609;
        }
        .btn-primary {
            background-color: #c62828;
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            cursor: pointer;
            font-size: 15px;
        }
        .btn-primary:hover { background-color: #b71c1c; }
        .form-control {
            border: 2px solid #ddd;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            width: 100%;
            font-size: 14px;
            margin-top: 0.5rem;
        }
        .form-control:focus {
            border-color: #c62828;
            box-shadow: 0 0 0 0.2rem rgba(198,40,40,0.15);
            outline: none;
        }
        .alert-danger {
            background-color: #ffe6e6;
            border: 2px solid #dc3545;
            color: #dc3545;
            border-left: 4px solid #dc3545;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }
        .password-strength {
            height: 5px;
            border-radius: 3px;
            margin-top: 8px;
            transition: all 0.3s;
            background: #ddd;
        }
        .strength-label {
            font-size: 12px;
            margin-top: 4px;
            color: #666;
        }
        .form-group { margin-bottom: 1.5rem; }
        label { font-weight: 600; display: block; }
    </style>
{% endblock %}

{% block body %}
<div class="login-section">
    <div class="container">
        <div class="form-container">
            <div style="text-align:center; margin-bottom:2rem;">
                <h1>🔒 New Password</h1>
                <p style="color:#666;">Choose a secure password</p>
            </div>

            {% if error %}
                <div class="alert-danger">⚠️ {{ error }}</div>
            {% endif %}

            {% for message in app.flashes('danger') %}
                <div class="alert-danger">⚠️ {{ message }}</div>
            {% endfor %}

            <form method="post">
                <div class="form-group">
                    <label for="password">
                        New Password <span style="color:#dc3545;">*</span>
                    </label>
                    <input type="password"
                           name="password"
                           id="password"
                           class="form-control"
                           placeholder="••••••••"
                           required
                           autofocus
                           oninput="checkStrength(this.value)">
                    <div class="password-strength" id="strengthBar"></div>
                    <div class="strength-label" id="strengthLabel"></div>
                </div>

                <div class="form-group">
                    <label for="confirm_password">
                        Confirm Password <span style="color:#dc3545;">*</span>
                    </label>
                    <input type="password"
                           name="confirm_password"
                           id="confirm_password"
                           class="form-control"
                           placeholder="••••••••"
                           required>
                </div>

                <button type="submit" class="btn-primary">
                    ✅ Reset Password
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function checkStrength(password) {
    const bar   = document.getElementById('strengthBar');
    const label = document.getElementById('strengthLabel');
    let score = 0;

    if (password.length >= 8)  score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    const levels = [
        { color: '#dc3545', text: 'Very Weak',  width: '25%'  },
        { color: '#fd7e14', text: 'Weak',       width: '50%'  },
        { color: '#ffc107', text: 'Medium',     width: '75%'  },
        { color: '#28a745', text: 'Strong',     width: '100%' },
    ];

    if (password.length === 0) {
        bar.style.width = '0';
        label.textContent = '';
        return;
    }

    const level = levels[score - 1] || levels[0];
    bar.style.background = level.color;
    bar.style.width = level.width;
    label.style.color = level.color;
    label.textContent = level.text;
}
</script>
{% endblock %}