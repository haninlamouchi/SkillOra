{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mot de passe oublié - Skillora{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .login-section {
            padding: 110px 0 60px 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .form-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 40px rgba(193, 6, 9, 0.15);
            padding: 40px;
            max-width: 550px;
            margin: 0 auto;
            border-top: 5px solid #c10609;
        }
        .btn-primary {
            background-color: #c62828;
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            cursor: pointer;
            font-size: 15px;
        }
        .btn-primary:hover { background-color: #b71c1c; }
        .form-control {
            border: 2px solid #ddd;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            width: 100%;
            font-size: 14px;
        }
        .form-control:focus {
            border-color: #c62828;
            box-shadow: 0 0 0 0.2rem rgba(198,40,40,0.15);
            outline: none;
        }
        .alert-success {
            background-color: #e6f9f0;
            border: 2px solid #28a745;
            color: #28a745;
            border-left: 4px solid #28a745;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }
        .alert-danger {
            background-color: #ffe6e6;
            border: 2px solid #dc3545;
            color: #dc3545;
            border-left: 4px solid #dc3545;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }
        .back-link {
            text-align: center;
            margin-top: 1.5rem;
        }
        .back-link a { color: #c62828; font-weight: 600; text-decoration: none; }
        .back-link a:hover { text-decoration: underline; }
    </style>
{% endblock %}

{% block body %}
<div class="login-section">
    <div class="container">
        <div class="form-container">
            <div class="page-header" style="text-align:center; margin-bottom:2rem;">
                <h1>🔑 Mot de passe oublié</h1>
                <p style="color:#666;">Entrez votre email pour recevoir un lien de réinitialisation</p>
            </div>

            {% if success %}
                <div class="alert-success">
                    ✅ Si cet email est enregistré, vous recevrez un lien dans quelques minutes. Vérifiez vos spams !
                </div>
                <div class="back-link">
                    <a href="{{ path('app_login') }}">← Retour à la connexion</a>
                </div>
            {% else %}
                <form method="post">
                    <div class="form-group" style="margin-bottom:1.5rem;">
                        <label for="email" style="font-weight:600; display:block; margin-bottom:0.5rem;">
                            Email <span style="color:#dc3545;">*</span>
                        </label>
                        <input type="email"
                               name="email"
                               id="email"
                               class="form-control"
                               placeholder="exemple@email.com"
                               required
                               autofocus>
                    </div>

                    <button type="submit" class="btn-primary">
                        📧 Envoyer le lien de réinitialisation
                    </button>
                </form>

                <div class="back-link">
                    <a href="{{ path('app_login') }}">← Retour à la connexion</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}