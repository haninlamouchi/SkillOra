{% extends 'frontoffice/base.html.twig' %}

{% block title %}Connexion - Skillora{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Supprimer l'espace blanc en haut */
        body {
            padding-top: 0 !important;
            margin: 0;
        }
        .login-section {
            padding: 110px 0 60px 0;
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
        }        
        .form-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 40px rgba(193, 6, 9, 0.15);
            padding: 40px;
            max-width: 550px;
            margin: 0 auto;
            border-top: 5px solid #c10609;
        }

    </style>
{% endblock %}

{% block body %}


<!-- CONTENU DU FORMULAIRE DE CONNEXION -->
<div class="login-section">
    <div class="container">
        <div class="form-container">
            <div class="page-header">
                <h1>🔐 Welcome Back!</h1>
                <p>Log in to access your learning platform</p>
            </div>

            {{ include('security/_login_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}