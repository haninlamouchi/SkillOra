{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ publication.titre }} - Forum{% endblock %}

{% block stylesheets %}
<style>
    .show-page { padding: 0 0 80px; background: var(--grey-light); min-height: 100vh; }
    .show-page .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }

    .show-hero {
        background: linear-gradient(135deg, #5a0000 0%, #8b1a1a 50%, #a52a2a 100%);
        color: #fff; padding: 100px 0 40px; position: relative; overflow: hidden;
    }
    .show-hero::before {
        content: ''; position: absolute; top: -50%; right: -20%;
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        border-radius: 50%;
    }
    .show-hero .container { display: flex; align-items: center; justify-content: space-between; gap: 20px; position: relative; z-index: 1; }
    .show-hero-text h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .show-hero-text p  { margin: 4px 0 0 0; color: rgba(255,255,255,0.9); font-size: 0.95rem; }
    .show-hero-btn { flex-shrink: 0; }
    .show-hero .btn-back {
        background: var(--white); color: var(--darkred); padding: 10px 22px; border-radius: 8px;
        font-weight: 700; font-size: 0.9rem; text-decoration: none;
        display: flex; align-items: center; gap: 6px; transition: var(--transition); border: none; cursor: pointer;
    }
    .show-hero .btn-back:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(90,0,0,0.3); color: var(--darkred); text-decoration: none; }

    .show-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-md); overflow: hidden; margin-top: 30px; margin-bottom: 28px; }

    /* ── MEDIA ── */
    .show-card-media { width: 100%; overflow: hidden; background: #000; }
    .show-card-media img   { width: 100%; max-height: 400px; object-fit: contain; display: block; background: #fff; }
    .show-card-media video { width: 100%; max-height: 400px; display: block; }

    .show-card-body { padding: 32px 36px; }

    .show-badges { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .badge { padding: 5px 14px; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 700; }
    .badge-type      { background: var(--red); color: var(--white); }
    .badge-published { background: #ecfdf5; color: #059669; }
    .badge-pending   { background: #fef3c7; color: #d97706; }

    .show-title { font-size: 1.5rem; font-weight: 800; color: var(--black); margin: 0 0 16px; line-height: 1.35; }
    .show-meta  { display: flex; gap: 20px; flex-wrap: wrap; color: #999; font-size: 0.85rem; margin-bottom: 24px; }
    .show-meta span { display: inline-flex; align-items: center; gap: 6px; }

    .show-content p { color: #444; font-size: 0.95rem; line-height: 1.75; margin: 0 0 28px; white-space: pre-line; }

    .show-actions { display: flex; gap: 12px; padding-top: 24px; border-top: 1px solid #e5e7eb; flex-wrap: wrap; }
    .btn-back { background: #f0f2f5; color: #555; padding: 11px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: var(--transition); }
    .btn-back:hover { background: #e4e6eb; text-decoration: none; }

    /* ── COMMENTAIRES ── */
    .comment-form-card {
        background: var(--white); border-radius: var(--radius); padding: 28px 32px;
        box-shadow: var(--shadow-sm); border: 1px solid #e5e7eb; margin-bottom: 28px;
    }
    .comment-form-card h3 { font-size: 1rem; font-weight: 700; color: var(--black); margin: 0 0 18px; display: flex; align-items: center; gap: 8px; }
    .comment-form-card h3 i { color: var(--darkred); }
    .comment-form-card textarea {
        width: 100%; padding: 14px 18px; border: 2px solid #e5e7eb; border-radius: 8px;
        font-size: 0.92rem; font-family: inherit; resize: vertical; min-height: 100px;
        transition: var(--transition); background: var(--grey-light); color: var(--black);
    }
    .comment-form-card textarea:focus { outline: none; border-color: var(--red); background: var(--white); box-shadow: 0 0 0 4px rgba(231,76,60,0.1); }
    .comment-form-card .btn-submit {
        background: linear-gradient(135deg, var(--darkred), var(--red));
        color: var(--white); margin-top: 12px; padding: 11px 24px; border: none;
        border-radius: 8px; font-weight: 600; cursor: pointer; transition: var(--transition);
        display: inline-flex; align-items: center; gap: 6px;
    }
    .comment-form-card .btn-submit:hover { box-shadow: 0 4px 12px rgba(229,76,60,0.3); }
    .comment-form-card .form-error { color: #dc2626; font-size: 0.8rem; margin-top: 6px; }

    .comments-section { margin-top: 40px; padding-top: 40px; border-top: 2px solid #e5e7eb; }
    .comments-header h2 { font-size: 1.3rem; font-weight: 700; color: var(--black); margin: 0 0 20px; display: flex; align-items: center; gap: 8px; }
    .comments-count { background: var(--red); color: var(--white); padding: 2px 10px; border-radius: 20px; font-size: 0.8rem; }

    .comment-card {
        background: var(--white); border-radius: 8px; padding: 20px 24px;
        margin-bottom: 14px; box-shadow: var(--shadow-sm); border: 1px solid #e5e7eb;
        transition: var(--transition);
    }
    .comment-card:hover { box-shadow: var(--shadow-md); border-color: transparent; }

    .comment-top { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
    .comment-avatar {
        width: 40px; height: 40px; border-radius: 50%;
        background: linear-gradient(135deg, var(--darkred), var(--red));
        color: var(--white); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.8rem; flex-shrink: 0;
    }
    .comment-info { flex: 1; }
    .comment-author { font-weight: 700; font-size: 0.88rem; color: var(--black); display: flex; align-items: center; gap: 8px; }
    .comment-author .own-badge { background: #ecfdf5; color: #059669; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 0.65rem; font-weight: 700; }
    .comment-date { color: #999; font-size: 0.78rem; margin-top: 2px; }
    .comment-body { color: #444; font-size: 0.92rem; line-height: 1.7; margin: 0 0 0 52px; white-space: pre-line; }

    .comment-actions { display: flex; gap: 8px; margin: 10px 0 0 52px; }
    .comment-actions a { padding: 5px 14px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; text-decoration: none; transition: var(--transition); display: inline-flex; align-items: center; gap: 5px; }
    .btn-comment-edit   { background: #f0f2f5; color: #555; }
    .btn-comment-edit:hover   { background: #e4e6eb; text-decoration: none; }
    .btn-comment-delete { background: #fef2f2; color: #dc2626; }
    .btn-comment-delete:hover { background: #dc2626; color: var(--white); text-decoration: none; }

    .no-comments { text-align: center; padding: 40px 20px; background: var(--white); border-radius: 8px; box-shadow: var(--shadow-sm); margin-bottom: 20px; }
    .no-comments i { font-size: 2.5rem; color: #e5e7eb; margin-bottom: 12px; display: block; }
    .no-comments p { color: #999; font-size: 0.95rem; margin: 0; }

    .flash-msg { padding: 14px 18px; border-radius: 8px; margin-bottom: 16px; font-weight: 600; font-size: 0.9rem; }
    .flash-msg.success { background: #ecfdf5; border-left: 4px solid #059669; color: #065f46; }
    .flash-msg.error   { background: #fef2f2; border-left: 4px solid #dc2626; color: #7f1d1d; }

    /* ── TRADUCTION ── */
    .translate-box { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .translate-box select { padding: 4px 8px; border-radius: 6px; border: 1px solid #e5e7eb; font-size: 0.78rem; color: #555; cursor: pointer; }
    .translate-box button { padding: 4px 12px; border-radius: 6px; border: 1px solid #e5e7eb; background: #f0f2f5; font-size: 0.78rem; font-weight: 600; color: #555; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: var(--transition); }
    .translate-box button:hover { background: #e4e6eb; }
    .translate-result { margin-top: 8px; padding: 10px 14px; background: #f8fafc; border-left: 3px solid var(--red); border-radius: 6px; font-size: 0.88rem; color: #444; font-style: italic; display: none; }

    @media (max-width: 768px) {
        .show-page { padding: 0 0 40px; }
        .show-card-body { padding: 24px 20px; }
        .show-meta { flex-direction: column; gap: 8px; }
        .comment-body, .comment-actions { margin-left: 0; }
        .comment-form-card { padding: 20px; }
        .show-hero { padding: 80px 0 30px; }
        .show-hero .container { flex-direction: column; align-items: flex-start; }
        .show-hero h1 { font-size: 1.4rem; }
        .show-hero-btn { width: 100%; }
        .show-hero .btn-back { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<section class="show-page">
    <div class="show-hero">
        <div class="container">
            <div class="show-hero-text">
                <h1>{{ publication.titre }}</h1>
                <p>Forum — Publication de {{ publication.user.prenom }} {{ publication.user.nom }}</p>
            </div>
            <div class="show-hero-btn">
                <a href="{{ path('app_forum_index') }}{% if currentUser %}?u={{ currentUser.id }}{% endif %}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-msg {{ label }}">
                    <i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="show-card">
            {# ── MEDIA ── #}
            {% if publication.fichier %}
                {% set ext = publication.fichier|split('.')|last|lower %}
                <div class="show-card-media">
                    {% if ext in ['jpg','jpeg','png','gif','webp'] %}
                        <img src="{{ asset('uploads/publications/' ~ publication.fichier) }}" alt="{{ publication.titre }}">
                    {% elseif ext in ['mp4','webm','ogg'] %}
                        <video controls>
                            <source src="{{ asset('uploads/publications/' ~ publication.fichier) }}" type="video/{{ ext }}">
                        </video>
                    {% endif %}
                </div>
            {% endif %}

            <div class="show-card-body">
                <div class="show-badges">
                    <span class="badge badge-type">
                        {% if publication.typecontenu.value == 'image' %}<i class="fa fa-image"></i>
                        {% elseif publication.typecontenu.value == 'video' %}<i class="fa fa-video"></i>
                        {% else %}<i class="fa fa-align-left"></i>{% endif %}
                        {{ publication.typecontenu.label }}
                    </span>
                    <span class="badge {{ publication.status.value == 'publié' ? 'badge-published' : 'badge-pending' }}">
                        <i class="fas fa-{{ publication.status.value == 'publié' ? 'check-circle' : 'clock' }}"></i>
                        {{ publication.status.value == 'publié' ? 'Publié' : 'En attente' }}
                    </span>
                </div>

                <div class="show-meta">
                    <span><i class="far fa-calendar-alt"></i> {{ publication.datePublication|date('d/m/Y H:i') }}</span>
                    <span><i class="far fa-user"></i> {{ publication.user.prenom }} {{ publication.user.nom }}</span>
                    <span><i class="far fa-comment"></i> {{ publication.commentaires|length }} commentaire(s)</span>
                </div>

                <div class="show-content">
                    <p>{{ publication.contenu|nl2br }}</p>
                </div>

                {# ── TRADUCTION PUBLICATION ── #}
                <div class="translate-box">
                    <span style="font-size:0.78rem;color:#999;font-weight:600;">🌐 Traduire :</span>
                    <select class="lang-select-pub">
                        <option value="en">🇬🇧 Anglais</option>
                        <option value="fr">🇫🇷 Français</option>
                        <option value="ar">🇸🇦 Arabe</option>
                        <option value="es">🇪🇸 Espagnol</option>
                        <option value="de">🇩🇪 Allemand</option>
                    </select>
                    <button class="translate-btn-pub" data-text="{{ publication.contenu }}">
                        🌐 Traduire la publication
                    </button>
                </div>
                <div class="translate-result translate-result-pub"></div>

                <div class="show-actions">
                    <a href="{{ path('app_forum_index') }}{% if currentUser %}?u={{ currentUser.id }}{% endif %}" class="btn-back">
                        <i class="fas fa-arrow-left"></i> Retour au Forum
                    </a>
                </div>
            </div>
        </div>

        {# ── FORMULAIRE COMMENTAIRE ── #}
        {% if commentForm %}
            <div class="comment-form-card">
                <h3><i class="fas fa-pen"></i> Ajouter un Commentaire</h3>
                {{ form_start(commentForm, {
                    'action': path('app_forum_show', {id: publication.id}) ~ '?u=' ~ currentUser.id,
                    'attr': {'novalidate': 'novalidate'}
                }) }}
                    {{ form_errors(commentForm) }}
                    {{ form_widget(commentForm.contenu, {'attr': {
                        'placeholder': 'Écrivez votre commentaire ici…',
                        'rows': 4
                    }}) }}
                    {% if commentForm.contenu.vars.errors|length > 0 %}
                        {% for error in commentForm.contenu.vars.errors %}
                            <div class="form-error"><i class="fas fa-exclamation-triangle"></i> {{ error.message }}</div>
                        {% endfor %}
                    {% endif %}
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i> Poster
                    </button>
                {{ form_end(commentForm) }}
            </div>
        {% endif %}

        {# ── LISTE COMMENTAIRES ── #}
        <div class="comments-section">
            <div class="comments-header">
                <h2>
                    <i class="far fa-comments"></i> Commentaires
                    <span class="comments-count">{{ publication.commentaires|length }}</span>
                </h2>
            </div>

            {% if publication.commentaires|length == 0 %}
                <div class="no-comments">
                    <i class="far fa-comment-dots"></i>
                    <p>Aucun commentaire pour l'instant. Soyez le premier !</p>
                </div>
            {% else %}
                {% for comment in publication.commentaires %}
                    <div class="comment-card">
                        <div class="comment-top">
                            <div class="comment-avatar">
                                {{ comment.user.prenom|slice(0,1)|upper }}{{ comment.user.nom|slice(0,1)|upper }}
                            </div>
                            <div class="comment-info">
                                <div class="comment-author">
                                    {{ comment.user.prenom }} {{ comment.user.nom }}
                                    {% if currentUser and comment.user.id == currentUser.id %}
                                        <span class="own-badge">VOUS</span>
                                    {% endif %}
                                </div>
                                <div class="comment-date">{{ comment.dateCommentaire|date('d/m/Y H:i') }}</div>
                            </div>
                        </div>
                        <div class="comment-body">{{ comment.contenu }}</div>

                        {# ── TRADUCTION COMMENTAIRE ── #}
                        <div class="translate-box" style="margin-left:52px;">
                            <select class="lang-select-comment">
                                <option value="en">🇬🇧 Anglais</option>
                                <option value="fr">🇫🇷 Français</option>
                                <option value="ar">🇸🇦 Arabe</option>
                                <option value="es">🇪🇸 Espagnol</option>
                                <option value="de">🇩🇪 Allemand</option>
                            </select>
                            <button class="translate-btn-comment" data-text="{{ comment.contenu }}">
                                🌐 Traduire
                            </button>
                        </div>
                        <div class="translate-result translate-result-comment" style="margin-left:52px;"></div>

                        {% if currentUser and comment.user.id == currentUser.id %}
                            <div class="comment-actions">
                                <a href="{{ path('app_forum_commentaire_edit', {commentaireId: comment.id}) }}?u={{ currentUser.id }}" class="btn-comment-edit">
                                    <i class="far fa-edit"></i> Modifier
                                </a>
                                <a href="{{ path('app_forum_commentaire_delete', {commentaireId: comment.id}) }}?u={{ currentUser.id }}"
                                   class="btn-comment-delete"
                                   onclick="return confirm('Supprimer ce commentaire ?')">
                                    <i class="far fa-trash-alt"></i> Supprimer
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</section>

<script>
// ── Traduction PUBLICATION ──
document.querySelector('.translate-btn-pub').addEventListener('click', async function () {
    const text     = this.dataset.text;
    const lang     = document.querySelector('.lang-select-pub').value;
    const resultEl = document.querySelector('.translate-result-pub');

    this.disabled    = true;
    this.textContent = '⏳ Traduction...';

    const response = await fetch('/translate', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ text, lang }),
    });

    const data = await response.json();
    resultEl.style.display = 'block';
    resultEl.textContent   = '📝 ' + (data.translated ?? 'Erreur de traduction');
    this.disabled    = false;
    this.textContent = '🌐 Traduire la publication';
});

// ── Traduction COMMENTAIRES ──
document.querySelectorAll('.translate-btn-comment').forEach(btn => {
    btn.addEventListener('click', async function () {
        const text     = this.dataset.text;
        const box      = this.closest('.comment-card');
        const lang     = box.querySelector('.lang-select-comment').value;
        const resultEl = box.querySelector('.translate-result-comment');

        this.disabled    = true;
        this.textContent = '⏳ Traduction...';

        const response = await fetch('/translate', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ text, lang }),
        });

        const data = await response.json();
        resultEl.style.display = 'block';
        resultEl.textContent   = '📝 ' + (data.translated ?? 'Erreur de traduction');
        this.disabled    = false;
        this.textContent = '🌐 Traduire';
    });
});
</script>
{% endblock %}