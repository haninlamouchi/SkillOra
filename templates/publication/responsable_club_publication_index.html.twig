{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Publications - Responsable Club{% endblock %}

{% block stylesheets %}
<style>
    .rc-page { padding: 0 0 60px; background: var(--grey-light); min-height: 100vh; }
    .rc-page .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    .pub-hero {
        background: linear-gradient(135deg, #5a0000 0%, #8b1a1a 50%, #a52a2a 100%);
        color: #fff; padding: 100px 0 70px; position: relative; overflow: hidden;
    }
    .pub-hero::before {
        content: ''; position: absolute; top: -50%; right: -20%;
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        border-radius: 50%;
    }
    .pub-hero .container { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 30px; position: relative; z-index: 1; }
    .pub-hero h1 { font-size: 2.2rem; font-weight: 800; margin: 0; line-height: 1.1; }
    .pub-hero p { font-size: 1.05rem; color: rgba(255,255,255,0.9); margin: 8px 0 0; }
    .pub-hero-text { flex: 1; min-width: 250px; }
    .pub-hero-btn  { flex-shrink: 0; display: flex; gap: 12px; flex-wrap: wrap; }
    .pub-hero .btn-add {
        background: var(--white); color: var(--darkred); padding: 11px 28px; border-radius: 8px;
        font-weight: 700; font-size: 0.95rem; text-decoration: none;
        display: flex; align-items: center; gap: 8px; transition: var(--transition); border: none; cursor: pointer;
    }
    .pub-hero .btn-add:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(90,0,0,0.3); text-decoration: none; }
    
    .pub-hero .btn-ai {
        background: var(--white); 
        color: var(--darkred); 
        padding: 11px 28px; 
        border-radius: 8px;
        font-weight: 700; 
        font-size: 0.95rem; 
        text-decoration: none;
        display: flex; 
        align-items: center; 
        gap: 8px; 
        transition: var(--transition); 
        border: none; 
        cursor: pointer;
    }
    .pub-hero .btn-ai:hover { 
        transform: scale(1.05); 
        box-shadow: 0 6px 20px rgba(90,0,0,0.3); 
        text-decoration: none; 
        color: var(--darkred);
    }

    .pub-search-bar {
        background: var(--white); padding: 20px 24px; border-radius: var(--radius);
        display: flex; gap: 12px; align-items: center; margin: 30px 0;
        box-shadow: var(--shadow-sm); flex-wrap: wrap;
    }
    .pub-search-bar input  { flex: 1; min-width: 200px; padding: 10px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.95rem; transition: var(--transition); }
    .pub-search-bar input:focus { outline: none; border-color: var(--red); box-shadow: 0 0 0 3px rgba(229,76,60,0.1); }
    .pub-search-bar input::placeholder { color: #999; }
    .pub-search-bar select { padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.9rem; background: var(--white); color: #333; cursor: pointer; transition: var(--transition); }
    .pub-search-bar select:focus { outline: none; border-color: var(--red); }
    .pub-search-bar .btn-reset { padding: 10px 20px; background: #f0f2f5; border: none; border-radius: 8px; color: #555; font-weight: 600; cursor: pointer; transition: var(--transition); display: flex; align-items: center; gap: 6px; }
    .pub-search-bar .btn-reset:hover { background: #e4e6eb; }

    .results-count { color: #666; font-size: 0.9rem; margin-bottom: 20px; font-weight: 600; }
    .results-count strong { color: var(--darkred); font-size: 1.1rem; }

    .pub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }

    .pub-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; border: 1px solid #e5e7eb; transition: var(--transition); }
    .pub-card:hover { box-shadow: var(--shadow-md); border-color: transparent; }
    .pub-card.hidden { display: none; }

    /* ── MEDIA ── */
    .pub-card-media { width: 100%; height: 200px; background: var(--grey-light); overflow: hidden; }
    .pub-card-media img   { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pub-card-media video { width: 100%; height: 100%; object-fit: cover; display: block; }

    .pub-card-body    { padding: 18px 20px; }
    .pub-card-badges  { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
    .pub-card-badge   { display: inline-flex; align-items: center; gap: 4px; background: var(--red); color: var(--white); padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
    .pub-card-status  { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.75rem; }
    .pub-card-status.status-published { background: #ecfdf5; color: #059669; }
    .pub-card-status.status-pending   { background: #fef3c7; color: #d97706; }

    .pub-card-title   { font-size: 1.1rem; font-weight: 700; color: #000; margin: 0 0 8px 0; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pub-card-meta    { display: flex; align-items: center; gap: 16px; color: #999; font-size: 0.8rem; margin-bottom: 12px; }
    .pub-card-excerpt { color: #666; font-size: 0.9rem; line-height: 1.5; margin: 12px 0 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .pub-card-footer { display: flex; gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid #e5e7eb; flex-wrap: wrap; }
    .btn-show, .btn-edit, .btn-validate {
        flex: 1; min-width: 70px; padding: 8px 12px; border-radius: 6px; font-weight: 600;
        font-size: 0.8rem; text-decoration: none; display: flex; align-items: center;
        justify-content: center; gap: 4px; transition: var(--transition); border: none; cursor: pointer;
    }
    .btn-show     { background: linear-gradient(135deg, var(--darkred), var(--red)); color: var(--white); }
    .btn-show:hover { box-shadow: 0 4px 12px rgba(229,76,60,0.3); text-decoration: none; color: var(--white); }
    .btn-edit     { background: #f0f2f5; color: #555; }
    .btn-edit:hover { background: #e4e6eb; text-decoration: none; color: #555; }
    .btn-validate { background: #ecfdf5; color: #059669; }
    .btn-validate:hover { background: #059669; color: var(--white); text-decoration: none; }

    .empty-state { text-align: center; padding: 60px 20px; color: #999; }
    .empty-state-icon { width: 80px; height: 80px; margin: 0 auto 20px; background: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: var(--red); }
    .empty-state h3 { color: #333; font-size: 1.3rem; margin: 0 0 8px 0; }
    .empty-state p  { margin: 0; color: #999; font-size: 0.95rem; }

    @media (max-width: 768px) {
        .pub-hero { padding: 80px 0 50px; }
        .pub-hero .container { flex-direction: column; align-items: flex-start; gap: 20px; }
        .pub-hero h1 { font-size: 1.8rem; }
        .pub-hero-btn { width: 100%; }
        .pub-hero .btn-add { width: 100%; justify-content: center; }
        .pub-grid { grid-template-columns: 1fr; }
        .pub-search-bar { flex-direction: column; }
        .pub-search-bar input, .pub-search-bar select { width: 100%; }
        .pub-search-bar .btn-reset { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<section class="rc-page">
    <div class="pub-hero">
        <div class="container">
            <div class="pub-hero-text">
                <h1>Mes Publications</h1>
                <p>Gérez vos publications de club</p>
            </div>
            <div class="pub-hero-btn">
                <a class="btn-add" href="{{ path('app_responsable_club_publication_new') }}">
                    <i class="fas fa-plus"></i> Nouvelle Publication
                </a>
                <button type="button" id="btnAIHelper" class="btn-ai">
                    <i class="fas fa-sparkles"></i> Générer avec l'IA
                </button>
            </div>
        </div>
    </div>

    <div class="rc-page container">
        <div class="pub-search-bar">
            <input type="text" id="searchInput" placeholder="Rechercher par titre, contenu…">
            <select id="filterType">
                <option value="">Tous les types</option>
                <option value="image">Image</option>
                <option value="video">Vidéo</option>
                <option value="texte">Texte</option>
            </select>
            <select id="filterStatus">
                <option value="">Tous les statuts</option>
                <option value="en_attente">En attente</option>
                <option value="publié">Publié</option>
            </select>
            <select id="filterDate">
                <option value="">Toutes dates</option>
                <option value="today">Aujourd'hui</option>
                <option value="week">Cette semaine</option>
                <option value="month">Ce mois</option>
                <option value="year">Cette année</option>
            </select>
            <select id="sortBy">
                <option value="date-desc">Date (Plus récent)</option>
                <option value="date-asc">Date (Plus ancien)</option>
                <option value="title-asc">Titre (A-Z)</option>
                <option value="title-desc">Titre (Z-A)</option>
            </select>
            <button class="btn-reset" id="btnReset"><i class="fas fa-redo"></i> Réinitialiser</button>
        </div>

        <div class="results-count">
            <strong id="resultsCount">{{ publications.getTotalItemCount }}</strong> publication(s) trouvée(s)
        </div>

        {% if publications is not empty %}
            <div class="pub-grid" id="publicationsGrid">
                {% for publication in publications %}
                    <div class="pub-card"
                         data-title="{{ publication.titre|lower }}"
                         data-content="{{ publication.contenu|lower }}"
                         data-type="{{ publication.typecontenu.value }}"
                         data-status="{{ publication.status.value }}"
                         data-date="{{ publication.datePublication|date('Y-m-d H:i:s') }}">

                        {# ── MEDIA dans son div ── #}
                        {% if publication.fichier %}
                            {% set ext = publication.fichier|split('.')|last|lower %}
                            <div class="pub-card-media">
                                {% if ext in ['jpg','jpeg','png','gif','webp'] %}
                                    <img src="{{ asset('uploads/publications/' ~ publication.fichier) }}"
                                         alt="{{ publication.titre }}" loading="lazy">
                                {% elseif ext in ['mp4','webm','ogg'] %}
                                    <video controls preload="metadata">
                                        <source src="{{ asset('uploads/publications/' ~ publication.fichier) }}"
                                                type="video/{{ ext }}">
                                    </video>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="pub-card-body">
                            <div class="pub-card-badges">
                                <span class="pub-card-badge">
                                    {% if publication.typecontenu.value == 'image' %}<i class="fa fa-image"></i>
                                    {% elseif publication.typecontenu.value == 'video' %}<i class="fa fa-video"></i>
                                    {% else %}<i class="fa fa-align-left"></i>{% endif %}
                                    {{ publication.typecontenu.label }}
                                </span>
                                <span class="pub-card-status {{ publication.status.value == 'publié' ? 'status-published' : 'status-pending' }}">
                                    <i class="fas fa-{{ publication.status.value == 'publié' ? 'check-circle' : 'clock' }}"></i>
                                    {{ publication.status.value == 'publié' ? 'Publié' : 'En attente' }}
                                </span>
                            </div>

                            <h3 class="pub-card-title">{{ publication.titre }}</h3>

                            <div class="pub-card-meta">
                                <i class="far fa-calendar-alt"></i> {{ publication.datePublication|date('d/m/Y H:i') }}
                            </div>

                            <p class="pub-card-excerpt">
                                {{ publication.contenu|slice(0,120) }}{% if publication.contenu|length > 120 %}…{% endif %}
                            </p>

                            <div class="pub-card-footer">
                                <a class="btn-show"
                                   href="{{ path('app_responsable_club_publication_show', {'id': publication.id}) }}">
                                    <i class="far fa-eye"></i> Voir
                                </a>
                                <a class="btn-edit"
                                   href="{{ path('app_responsable_club_publication_edit', {'id': publication.id}) }}">
                                    <i class="far fa-edit"></i> Modifier
                                </a>
                                {% if publication.status.value != 'publié' %}
                                    <a class="btn-validate"
                                       href="{{ path('app_responsable_club_publication_valider', {'id': publication.id}) }}"
                                       onclick="return confirm('Publier cette publication ?')">
                                        <i class="fas fa-check"></i> Valider
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Pagination #}
            {% if publications.getTotalItemCount > 0 %}
                <div style="margin-top: 2rem;">
                    {{ knp_pagination_render(publications, 'pagination/custom_pagination.html.twig') }}
                </div>
            {% endif %}
        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-inbox"></i></div>
                <h3>Aucune publication</h3>
                <p>Commencez par créer votre première publication !</p>
                <a class="btn-add" href="{{ path('app_responsable_club_publication_new') }}"
                   style="margin-top:16px;display:inline-flex;">
                    <i class="fas fa-plus"></i> Créer Première Publication
                </a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput  = document.getElementById('searchInput');
    const filterType   = document.getElementById('filterType');
    const filterStatus = document.getElementById('filterStatus');
    const filterDate   = document.getElementById('filterDate');
    const sortBy       = document.getElementById('sortBy');
    const btnReset     = document.getElementById('btnReset');
    const resultsCount = document.getElementById('resultsCount');

    function matchesDate(dateStr, filter) {
        if (!filter) return true;
        const d = new Date(dateStr), now = new Date();
        if (filter === 'today') return d.toDateString() === now.toDateString();
        if (filter === 'week')  return d >= new Date(now - 7*864e5);
        if (filter === 'month') return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
        if (filter === 'year')  return d.getFullYear() === now.getFullYear();
        return true;
    }

    function run() {
        const term = searchInput.value.toLowerCase().trim();
        const tF = filterType.value, sF = filterStatus.value, dF = filterDate.value;
        let count = 0;
        document.querySelectorAll('.pub-card').forEach(c => {
            const ok = (!term || (c.dataset.title||'').includes(term) || (c.dataset.content||'').includes(term))
                    && (!tF || c.dataset.type === tF)
                    && (!sF || c.dataset.status === sF)
                    && matchesDate(c.dataset.date, dF);
            c.classList.toggle('hidden', !ok);
            c.style.display = ok ? '' : 'none';
            if (ok) count++;
        });
        resultsCount.textContent = count;
        sortCards();
    }

    function sortCards() {
        const grid = document.getElementById('publicationsGrid');
        if (!grid) return;
        Array.from(grid.querySelectorAll('.pub-card:not(.hidden)'))
            .sort((a, b) => {
                const aD = new Date(a.dataset.date), bD = new Date(b.dataset.date);
                if (sortBy.value === 'date-desc')  return bD - aD;
                if (sortBy.value === 'date-asc')   return aD - bD;
                if (sortBy.value === 'title-asc')  return (a.dataset.title||'').localeCompare(b.dataset.title||'');
                if (sortBy.value === 'title-desc') return (b.dataset.title||'').localeCompare(a.dataset.title||'');
                return 0;
            })
            .forEach(c => grid.appendChild(c));
    }

    searchInput.addEventListener('input', run);
    filterType.addEventListener('change', run);
    filterStatus.addEventListener('change', run);
    filterDate.addEventListener('change', run);
    sortBy.addEventListener('change', run);
    btnReset.addEventListener('click', () => {
        searchInput.value = ''; filterType.value = ''; filterStatus.value = '';
        filterDate.value = ''; sortBy.value = 'date-desc';
        document.querySelectorAll('.pub-card').forEach(c => { c.classList.remove('hidden'); c.style.display = ''; });
        resultsCount.textContent = document.querySelectorAll('.pub-card').length;
        sortCards();
    });
});

// AI Helper Modal Management - Wait for DOM to fully load
document.addEventListener('DOMContentLoaded', function() {
    console.log('AI Modal: Setting up modal management...');
    const aiHelperModal = document.getElementById('aiHelperModal');
    const btnAIHelper = document.getElementById('btnAIHelper');
    const closeAIModal = document.getElementById('closeAIModal');

    console.log('AI Modal: Elements found:', {
      modal: !!aiHelperModal,
      btn: !!btnAIHelper,
      closeBtn: !!closeAIModal
    });

    if (btnAIHelper && aiHelperModal) {
        btnAIHelper.addEventListener('click', function(e) {
            console.log('AI Modal: Button clicked!');
            e.preventDefault();
            e.stopPropagation();
            aiHelperModal.style.display = 'flex';
            console.log('AI Modal: Modal display set to flex');
        });
    }

    if (closeAIModal && aiHelperModal) {
        closeAIModal.addEventListener('click', function(e) {
            console.log('AI Modal: Close button clicked!');
            e.preventDefault();
            e.stopPropagation();
            aiHelperModal.style.display = 'none';
        });
    }

    // Close modal when clicking outside content
    if (aiHelperModal) {
        aiHelperModal.addEventListener('click', function(event) {
            console.log('AI Modal: Modal clicked, target:', event.target.id);
            if (event.target === aiHelperModal) {
                aiHelperModal.style.display = 'none';
            }
        });
    }
});
</script>

<!-- AI Helper Modal -->
<div id="aiHelperModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background-color: white; border-radius: 8px; width: 90%; max-width: 900px; max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.3); padding: 0;">
        <button type="button" id="closeAIModal" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #666; z-index: 10000;">
            <i class="fas fa-times"></i>
        </button>
        <div style="padding: 30px;">
            {% include 'components/_publication_ai_helper.html.twig' %}
        </div>
    </div>
</div>

{% endblock %}
