{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ publication.titre }} - Club Manager{% endblock %}

{% block stylesheets %}
<style>
    .show-page { padding: 0 0 80px; background: var(--grey-light); min-height: 100vh; }
    .show-page .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }

    .show-hero {
        background: linear-gradient(135deg, #5a0000 0%, #8b1a1a 50%, #a52a2a 100%);
        color: #fff;
        padding: 100px 0 40px;
        position: relative;
        overflow: hidden;
    }
    .show-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        border-radius: 50%;
    }
    .show-hero .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        z-index: 1;
    }

    .show-hero-text h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .show-hero-text p { margin: 4px 0 0 0; color: rgba(255,255,255,0.9); font-size: 0.95rem; }
    .show-hero-btn { flex-shrink: 0; }
    .show-hero .btn-back {
        background: var(--white);
        color: var(--darkred);
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
        border: none;
        cursor: pointer;
    }
    .show-hero .btn-back:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(90,0,0,0.3); color: var(--darkred); text-decoration: none; }

    .show-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-md); overflow: hidden; margin-top: 30px; }

    .show-card-media {
        width: 100%;
        max-width: 100%;
        max-height: 320px;
        aspect-ratio: 16/9;
        overflow: hidden;
        background: var(--grey-light);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }
    .show-card-media img {
        width: 100%;
        height: 100%;
        max-height: 320px;
        object-fit: contain;
        display: block;
        background: #fff;
    }
    .show-card-media video {
        width: 100%;
        max-height: 320px;
        display: block;
        border-radius: 12px;
    }
    @media (max-width: 768px) {
        .show-card-media {
            max-height: 200px;
            aspect-ratio: 16/10;
        }
        .show-card-media img, .show-card-media video {
            max-height: 200px;
        }
    }

    .show-card-body { padding: 32px 36px; }

    .show-badges { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .badge { padding: 5px 14px; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 700; }
    .badge-type { background: var(--red); color: var(--white); }
    .badge-published { background: #ecfdf5; color: #059669; }
    .badge-pending { background: #fef3c7; color: #d97706; }

    .show-title { font-size: 1.5rem; font-weight: 800; color: var(--black); margin: 0 0 16px; line-height: 1.35; }
    .show-meta { display: flex; gap: 20px; flex-wrap: wrap; color: #999; font-size: 0.85rem; margin-bottom: 24px; }
    .show-meta span { display: inline-flex; align-items: center; gap: 6px; }

    .show-content { background: transparent; padding: 0; margin-bottom: 28px; }
    .show-content p { color: #444; font-size: 0.95rem; line-height: 1.75; margin: 0; white-space: pre-line; }

    .show-actions { display: flex; gap: 12px; padding-top: 24px; border-top: 1px solid #e5e7eb; flex-wrap: wrap; }
    .btn-back { background: #f0f2f5; color: #555; padding: 11px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: var(--transition); }
    .btn-back:hover { background: #e4e6eb; text-decoration: none; }
    .btn-edit { background: linear-gradient(135deg, var(--darkred), var(--red)); color: var(--white); padding: 11px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: var(--transition); }
    .btn-edit:hover { box-shadow: 0 4px 12px rgba(229, 76, 60, 0.3); text-decoration: none; }

    @media (max-width: 768px) {
        .show-page { padding: 0 0 40px; }
        .show-card-body { padding: 24px 20px; }
        .show-actions { flex-direction: column; }
        .show-meta { flex-direction: column; gap: 8px; }
        .show-hero { padding: 80px 0 30px; }
        .show-hero .container { flex-direction: column; align-items: flex-start; }
        .show-hero h1 { font-size: 1.4rem; }
        .show-hero-btn { width: 100%; }
        .show-hero .btn-back { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<section class="show-page">
    <div class="show-hero">
        <div class="container">
            <div class="show-hero-text">
                <h1>{{ publication.titre }}</h1>
                <p>Publication de {{ publication.user.prenom }} {{ publication.user.nom }}</p>
            </div>
            <div class="show-hero-btn">
                <a href="{{ path('app_responsable_club_publication_index', {'u': currentUser.id}) }}" class="btn-back"><i class="fas fa-arrow-left"></i> Retour</a>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="show-card">
            {% if publication.fichier %}
                {% set ext = publication.fichier|split('.')|last|lower %}
                <div class="show-card-media">
                    {% if ext in ['jpg','jpeg','png','gif','webp'] %}
                        <img src="{{ asset('uploads/publications/' ~ publication.fichier) }}" alt="{{ publication.titre }}">
                    {% elseif ext in ['mp4','webm','ogg'] %}
                        <video controls><source src="{{ asset('uploads/publications/' ~ publication.fichier) }}" type="video/{{ ext }}"></video>
                    {% endif %}
                </div>
            {% endif %}

            <div class="show-card-body">
                <div class="show-badges">
                    <span class="badge badge-type">{{ publication.typecontenu.label }}</span>
                    <span class="badge {{ publication.status.value == 'publié' ? 'badge-published' : 'badge-pending' }}">
                        <i class="fas fa-{{ publication.status.value == 'publié' ? 'check-circle' : 'clock' }}"></i>
                        {{ publication.status.value == 'publié' ? 'Publié' : 'En attente' }}
                    </span>
                </div>

                <div class="show-meta">
                    <span><i class="far fa-calendar-alt"></i> {{ publication.datePublication|date('d/m/Y H:i') }}</span>
                    <span><i class="far fa-user"></i> {{ publication.user.prenom }} {{ publication.user.nom }}</span>
                </div>

                <div class="show-content">
                    <p>{{ publication.contenu|nl2br }}</p>
                </div>

                <div class="show-actions">
                    <a href="{{ path('app_responsable_club_publication_index', {'u': currentUser.id}) }}" class="btn-back"><i class="fas fa-arrow-left"></i> Retour</a>
                    <a href="{{ path('app_responsable_club_publication_edit', {'id': publication.id, 'u': currentUser.id}) }}" class="btn-edit"><i class="far fa-edit"></i> Modifier</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}