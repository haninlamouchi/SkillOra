{% extends 'frontoffice/base.html.twig' %}

{% block title %}Dashboard — SkillOra{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap');

    :root {
        --red:      #c10609;
        --red-soft: #fdf2f2;
        --ink:      #111111;
        --body:     #444444;
        --muted:    #888888;
        --border:   #e8e8e8;
        --bg:       #f8f8f8;
        --white:    #ffffff;
        --radius:   14px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body { background: var(--bg); font-family: 'Inter', sans-serif; color: var(--ink); }

    /* ─── SHELL ─── */
    .db-shell { min-height: 100vh; padding: 100px 0 80px; }
    .db-wrap  { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

    /* ─── HERO — fond blanc, bordure rouge en haut ─── */
    .hero-banner {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        border-top: 4px solid var(--red);
        padding: 36px 44px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.05);
    }

    .hero-left { flex: 1; }

    .hero-eyebrow {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .hero-eyebrow::before {
        content: '';
        display: inline-block;
        width: 20px; height: 2px;
        background: var(--red);
        border-radius: 2px;
    }

    .hero-name {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.15;
        margin-bottom: 8px;
    }
    .hero-name span { color: var(--red); }

    .hero-sub {
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 400;
    }

    .hero-avatar {
        width: 80px; height: 80px;
        border-radius: 50%;
        border: 3px solid var(--border);
        overflow: hidden;
        display: flex; align-items: center; justify-content: center;
        background: var(--red-soft);
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem; font-weight: 700;
        color: var(--red);
        flex-shrink: 0;
    }
    .hero-avatar img { width: 100%; height: 100%; object-fit: cover; }

    /* ─── STATS ─── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 24px 22px;
        box-shadow: 0 1px 8px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        position: relative;
        overflow: hidden;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.09);
        border-color: var(--red);
    }

    /* Accent gauche uniquement sur la carte principale */
    .stat-card.main {
        border-left: 4px solid var(--red);
    }

    .stat-icon {
        font-size: 1.4rem;
        margin-bottom: 16px;
        display: block;
    }

    .stat-num {
        font-family: 'Playfair Display', serif;
        font-size: 2.6rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 6px;
        display: block;
    }
    .stat-card.main .stat-num { color: var(--red); }

    .stat-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--muted);
    }

    /* ─── BOTTOM GRID ─── */
    .bottom-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    /* ─── PANEL ─── */
    .panel {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: 0 1px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }
    .panel-head {
        padding: 20px 26px;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
    }
    .panel-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: 0.2px;
    }
    .panel-tag {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--red);
        background: var(--red-soft);
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(193,6,9,0.15);
    }

    /* ─── ACTION ITEMS ─── */
    .action-list { padding: 8px; }

    .action-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 14px;
        border-radius: 10px;
        text-decoration: none;
        transition: background 0.15s;
        border: 1px solid transparent;
    }
    .action-item:hover {
        background: var(--red-soft);
        border-color: rgba(193,6,9,0.12);
        text-decoration: none;
    }

    .action-ico {
        width: 40px; height: 40px;
        border-radius: 10px;
        background: var(--bg);
        border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        transition: background 0.15s, border-color 0.15s;
    }
    .action-item:hover .action-ico {
        background: var(--red-soft);
        border-color: rgba(193,6,9,0.2);
    }

    .action-body { flex: 1; }
    .action-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink);
        display: block;
        margin-bottom: 2px;
    }
    .action-desc {
        font-size: 0.75rem;
        color: var(--muted);
        font-weight: 400;
    }

    .action-chevron {
        color: var(--muted);
        font-size: 0.7rem;
        transition: color 0.15s, transform 0.2s;
    }
    .action-item:hover .action-chevron {
        color: var(--red);
        transform: translateX(3px);
    }

    .action-sep { height: 1px; background: var(--border); margin: 4px 14px; }

    /* ─── PROFILE PANEL ─── */
    .profile-body { padding: 22px 26px; }

    .profile-av {
        width: 64px; height: 64px; border-radius: 50%;
        border: 2px solid var(--border);
        background: var(--red-soft);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem; font-weight: 700; color: var(--red);
        margin: 0 auto 14px; overflow: hidden;
    }
    .profile-av img { width: 100%; height: 100%; object-fit: cover; }

    .profile-fullname {
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        text-align: center;
        margin-bottom: 3px;
    }
    .profile-role-lbl {
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 20px;
    }

    .profile-sep { height: 1px; background: var(--border); margin-bottom: 18px; }

    .pinfo-row {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }
    .pinfo-row:last-of-type { border-bottom: none; }
    .pinfo-ic {
        width: 26px; height: 26px; border-radius: 7px;
        background: var(--red-soft);
        display: flex; align-items: center; justify-content: center;
        color: var(--red); font-size: 0.7rem; flex-shrink: 0; margin-top: 1px;
    }
    .pinfo-lbl { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); display: block; margin-bottom: 1px; }
    .pinfo-val { font-size: 0.82rem; font-weight: 600; color: var(--ink); word-break: break-word; }

    .btn-logout {
        display: flex; align-items: center; justify-content: center; gap: 7px;
        width: 100%; margin-top: 18px; padding: 10px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--muted);
        font-size: 0.8rem; font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-logout:hover {
        border-color: var(--red);
        color: var(--red);
        background: var(--red-soft);
        text-decoration: none;
    }

    /* ─── ANIMATIONS ─── */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .hero-banner { animation: fadeUp 0.4s ease both; }
    .stats-row   { animation: fadeUp 0.4s 0.08s ease both; }
    .bottom-grid { animation: fadeUp 0.4s 0.16s ease both; }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 1024px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .bottom-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
        .db-wrap { padding: 0 16px; }
        .hero-banner { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
        .hero-avatar { display: none; }
        .stats-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .hero-name { font-size: 1.8rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="db-shell">
<div class="db-wrap">

    {# ── HERO ── #}
    <div class="hero-banner">
        <div class="hero-left">
            <div class="hero-eyebrow">Espace Membre · SkillOra</div>
            <h1 class="hero-name">
                Bonjour, <span>{{ user.prenom }}</span>
            </h1>
            <p class="hero-sub">
                {{ "now"|date("d/m/Y") }} &nbsp;·&nbsp; Bienvenue dans votre espace personnel.
            </p>
        </div>
        <div class="hero-avatar">
            {% if user.photo %}
                <img src="{{ asset('uploads/photos/' ~ user.photo) }}" alt="">
            {% else %}
                {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
            {% endif %}
        </div>
    </div>

    {# ── STATS ── #}
    <div class="stats-row">
        <div class="stat-card main">
            <span class="stat-icon">📝</span>
            <span class="stat-num">{{ totalPublications ?? 0 }}</span>
            <div class="stat-label">Mes publications</div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">✅</span>
            <span class="stat-num">{{ publiees ?? 0 }}</span>
            <div class="stat-label">Publiées</div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">⏳</span>
            <span class="stat-num">{{ enAttente ?? 0 }}</span>
            <div class="stat-label">En attente</div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">💬</span>
            <span class="stat-num">{{ totalCommentaires ?? 0 }}</span>
            <div class="stat-label">Commentaires</div>
        </div>
    </div>

    {# ── BOTTOM ── #}
    <div class="bottom-grid">

        {# Actions #}
        <div class="panel">
            <div class="panel-head">
                <span class="panel-title">Actions rapides</span>
                <span class="panel-tag">Membre</span>
            </div>
            <div class="action-list">

                <a href="{{ path('app_forum_index') }}?u={{ user.id }}" class="action-item">
                    <div class="action-ico">🌐</div>
                    <div class="action-body">
                        <span class="action-label">Voir le forum</span>
                        <span class="action-desc">Parcourir les publications de la communauté</span>
                    </div>
                    <i class="fas fa-chevron-right action-chevron"></i>
                </a>

                <div class="action-sep"></div>

                <a href="{{ path('app_publication_index') }}?u={{ user.id }}" class="action-item">
                    <div class="action-ico">📋</div>
                    <div class="action-body">
                        <span class="action-label">Mes publications</span>
                        <span class="action-desc">Voir et gérer mes soumissions</span>
                    </div>
                    <i class="fas fa-chevron-right action-chevron"></i>
                </a>

                <div class="action-sep"></div>

                <a href="{{ path('app_publication_new', {'id': user.id}) }}" class="action-item">
                    <div class="action-ico">✍️</div>
                    <div class="action-body">
                        <span class="action-label">Nouvelle publication</span>
                        <span class="action-desc">Soumettre un contenu au forum</span>
                    </div>
                    <i class="fas fa-chevron-right action-chevron"></i>
                </a>

                <div class="action-sep"></div>

                <a href="{{ path('app_user_show', {'id': user.id}) }}" class="action-item">
                    <div class="action-ico">👤</div>
                    <div class="action-body">
                        <span class="action-label">Mon profil</span>
                        <span class="action-desc">Consulter et modifier mes informations</span>
                    </div>
                    <i class="fas fa-chevron-right action-chevron"></i>
                </a>

            </div>
        </div>

        {# Profil #}
        <div class="panel">
            <div class="panel-head">
                <span class="panel-title">Mon profil</span>
            </div>
            <div class="profile-body">

                <div class="profile-av">
                    {% if user.photo %}
                        <img src="{{ asset('uploads/photos/' ~ user.photo) }}" alt="">
                    {% else %}
                        {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                    {% endif %}
                </div>

                <div class="profile-fullname">{{ user.prenom }} {{ user.nom }}</div>
                <div class="profile-role-lbl">Membre</div>

                <div class="profile-sep"></div>

                <div class="pinfo-row">
                    <div class="pinfo-ic"><i class="fas fa-envelope"></i></div>
                    <div>
                        <span class="pinfo-lbl">Email</span>
                        <span class="pinfo-val">{{ user.email }}</span>
                    </div>
                </div>

                {% if user.telephone %}
                <div class="pinfo-row">
                    <div class="pinfo-ic"><i class="fas fa-phone"></i></div>
                    <div>
                        <span class="pinfo-lbl">Téléphone</span>
                        <span class="pinfo-val">{{ user.telephone }}</span>
                    </div>
                </div>
                {% endif %}

                {% if user.dateNaissance %}
                <div class="pinfo-row">
                    <div class="pinfo-ic"><i class="fas fa-birthday-cake"></i></div>
                    <div>
                        <span class="pinfo-lbl">Naissance</span>
                        <span class="pinfo-val">{{ user.dateNaissance|date('d/m/Y') }}</span>
                    </div>
                </div>
                {% endif %}

                <div class="pinfo-row">
                    <div class="pinfo-ic"><i class="fas fa-calendar-check"></i></div>
                    <div>
                        <span class="pinfo-lbl">Membre depuis</span>
                        <span class="pinfo-val">{{ user.dateInscription|date('d/m/Y') }}</span>
                    </div>
                </div>

                <a href="{{ path('app_logout') }}" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i> Se déconnecter
                </a>

            </div>
        </div>

    </div>

</div>
</div>
{% endblock %}
