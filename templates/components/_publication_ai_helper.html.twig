  display: none;
  padding: 12px 15px;
  border-radius: 8px;
  margin-top: 15px;
  font-size: 14px;
}

.ai-alert.show {
  display: block;
}

.ai-alert-error {
  background-color: #fee2e2;
  border: 1px solid #fecaca;
  color: #991b1b;
}

.ai-alert-success {
  background-color: #d1fae5;
  border: 1px solid #a7f3d0;
