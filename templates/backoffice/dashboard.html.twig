{% extends 'backoffice/base.html.twig' %}

{% block title %}Dashboard Admin | SkillOra{% endblock %}

{% block body %}

{# ══════════════════════════════════════════════════════════
   HEADER
══════════════════════════════════════════════════════════ #}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Tableau de bord</h4>
        <p class="text-muted small mb-0">Vue d'ensemble de la plateforme SkillOra</p>
    </div>
    
</div>

{# Flash messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'danger' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
            <i class="mdi mdi-{{ label == 'success' ? 'check-circle' : 'alert-circle' }} me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

{# ══════════════════════════════════════════════════════════
   STATS CARDS
══════════════════════════════════════════════════════════ #}
<div class="row mb-4">
    <div class="col-xl-3 col-sm-6 mb-3">
        <div class="card card-rounded border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center " style="width:52px;height:52px;flex-shrink:0;">
                    <i class="mdi mdi-book-open-variant text-primary" style="font-size:1.6rem;"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1">Formations</p>
                    <h3 class="fw-bold mb-0">{{ totalFormations }}</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 mb-3">
        <div class="card card-rounded border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center " style="width:52px;height:52px;flex-shrink:0;">
                    <i class="mdi mdi-domain text-success" style="font-size:1.6rem;"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1">Clubs</p>
                    <h3 class="fw-bold mb-0">{{ totalClubs }}</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 mb-3">
        <div class="card card-rounded border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center " style="width:52px;height:52px;flex-shrink:0;">
                    <i class="mdi mdi-account-group text-warning" style="font-size:1.6rem;"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1">Utilisateurs</p>
                    <h3 class="fw-bold mb-0">{{ totalUsers }}</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 mb-3">
        <div class="card card-rounded border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;flex-shrink:0;">
                    <i class="mdi mdi-account-check text-info" style="font-size:1.6rem;"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1">Participations</p>
                    <h3 class="fw-bold mb-0">{{ totalParticipations }}</h3>
                </div>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════
   FILTERS
══════════════════════════════════════════════════════════ #}
<div class="card card-rounded border-0 shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3"><i class="mdi mdi-filter-variant me-2 text-primary"></i>Filtrer les formations</h5>
        <form method="GET" action="{{ path('admin_dashboard') }}" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Recherche</label>
                <input type="text" name="keyword" class="form-control form-control-sm"
                       placeholder="Titre ou description..." value="{{ filters.keyword }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Club</label>
                <select name="club_id" class="form-select form-select-sm">
                    <option value="">Tous les clubs</option>
                    {% for club in clubs %}
                        <option value="{{ club.id }}" {{ filters.club_id == club.id ? 'selected' }}>{{ club.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Du</label>
                <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Au</label>
                <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify"></i>
                </button>
                
                <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary btn-sm w-100" title="Réinitialiser">
                    <i class="mdi mdi-refresh"></i>
                </a>
                
            </div>
            <div class="col-md-2">
    <button
    class="btn btn-primary w-100"
    data-bs-toggle="modal"
    data-bs-target="#calendarModal">

    Voir calendrier

    </button>
</div>
            
        </form>
    </div>
</div>

{# ══════════════════════════════════════════════════════════
   FORMATIONS GRID / LIST TOGGLE
══════════════════════════════════════════════════════════ #}
<div class="card card-rounded border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-book-multiple me-2 text-primary"></i>
                Formations
                <span class="badge fw-bold fs-25 text-primary">{{ formations|length }}</span>
            </h5>
            <div class="d-flex justify-content-end mb-3">
                <button id="btn-grid" class="btn btn-primary me-2">Grid</button>
                <button id="btn-list" class="btn btn-outline-primary">List</button>
            </div>
        </div>

        {% if formations is empty %}
            <div class="text-center py-5 text-muted">
                <i class="mdi mdi-book-open-page-variant" style="font-size:3rem;opacity:.3;"></i>
                <p class="mt-2">Aucune formation trouvée.</p>
            </div>
        {% else %}

        {% set today = "now"|date("Y-m-d") %}

        {# ---------------- GRID CARDS ---------------- #}
        <div id="grid-view" class="row g-3 mb-2">
            {% for f in formations %}
            <div class="col-xl-4 col-md-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:14px;overflow:hidden;">
                    {# Image #}
                    {% if f.image %}
                        <img src="{{ f.image }}" alt="{{ f.titre }}"
                             style="width:100%;height:190px;object-fit:cover;">
                    {% else %}
                        <div style="width:100%;height:190px;background:linear-gradient(135deg,#f0f0f0,#e0e0e0);display:flex;align-items:center;justify-content:center;">
                            <i class="mdi mdi-image-off text-muted" style="font-size:3rem;"></i>
                        </div>
                    {% endif %}

                    <div class="card-body d-flex flex-column p-3">
                        {# Status badge #}
                        <div class="mb-2">
                            {% if f.dateFin and f.dateFin|date('Y-m-d') < today %}
                                <span class="badge badge-opacity-danger">Terminée</span>
                            {% elseif f.dateDebut and f.dateDebut|date('Y-m-d') <= today %}
                                <span class="badge badge-opacity-success">En cours</span>
                            {% else %}
                                <span class="badge badge-opacity-warning">À venir</span>
                            {% endif %}
                            <span class="badge bg-primary ms-1">
                                <i class="mdi mdi-account-group me-1"></i>{{ f.participations|length }}
                            </span>
                        </div>

                        {# Title #}
                        <h6 class="fw-bold mb-1" style="font-size:.95rem;">{{ f.titre }}</h6>

                        {# Description #}
                        {% if f.description %}
                            <p class="text-muted mb-2" style="font-size:.82rem;line-height:1.5;flex-grow:1;">
                                {{ f.description|slice(0,90) }}{{ f.description|length > 90 ? '…' }}
                            </p>
                        {% else %}
                            <p class="text-muted mb-2 flex-grow-1" style="font-size:.82rem;">—</p>
                        {% endif %}

                        {# Meta info #}
                        <div class="d-flex flex-column gap-1 mb-3" style="font-size:.78rem;color:#666;">
                            <span><i class="mdi mdi-domain me-1 text-primary"></i>{{ f.club ? f.club.nom : '—' }}</span>
                            <span><i class="mdi mdi-calendar-start me-1 text-primary"></i>{{ f.dateDebut ? f.dateDebut|date('d/m/Y') : '—' }} → {{ f.dateFin ? f.dateFin|date('d/m/Y') : '—' }}</span>
                        </div>

                        {# Action buttons #}
                        <div class="d-flex gap-2 mt-auto">
                            <a href="{{ path('admin_formation_show', {id: f.id}) }}"
                               class="btn btn-sm btn-outline-secondary flex-fill" title="Voir">
                                <i class="mdi mdi-eye me-1"></i>Voir
                            </a>
                            
                            <form method="POST" action="{{ path('admin_formation_delete', {id: f.id}) }}"
                                  class="d-inline" data-confirm="Supprimer cette formation ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ f.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                    <i class="mdi mdi-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        {# ---------------- LIST / TABLE ---------------- #}
        <div id="list-view" class="table-responsive" style="display:none;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Titre</th>
                        <th>Club</th>
                        <th>Responsable</th>
                        <th>Date début</th>
                        <th>Date fin</th>
                        <th class="text-center">Participants</th>
                        <th class="text-center">Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for f in formations %}
                    <tr>
                        <td>
                            <span class="fw-semibold">{{ f.titre }}</span>
                            {% if f.description %}
                                <br><small class="text-muted">{{ f.description|slice(0, 60) }}{{ f.description|length > 60 ? '…' }}</small>
                            {% endif %}
                        </td>
                        <td>{{ f.club ? f.club.nom : '—' }}</td>
                        <td>{{ f.club and f.club.responsable ? f.club.responsable.fullName : '—' }}</td>
                        <td>{{ f.dateDebut ? f.dateDebut|date('d/m/Y') : '—' }}</td>
                        <td>{{ f.dateFin ? f.dateFin|date('d/m/Y') : '—' }}</td>
                        <td class="text-center">{{ f.participations|length }}</td>
                        <td class="text-center">
                            {% if f.dateFin and f.dateFin|date('Y-m-d') < today %}
                                <span class="badge badge-opacity-danger">Terminée</span>
                            {% elseif f.dateDebut and f.dateDebut|date('Y-m-d') <= today %}
                                <span class="badge badge-opacity-success">En cours</span>
                            {% else %}
                                <span class="badge badge-opacity-warning">À venir</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('admin_formation_show', {id: f.id}) }}"
                               class="btn btn-sm btn-outline-secondary me-1" title="Voir">
                                <i class="mdi mdi-eye"></i>
                            </a>
                            
                            <form method="POST" action="{{ path('admin_formation_delete', {id: f.id}) }}"
                                  class="d-inline" data-confirm="Supprimer cette formation ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ f.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                    <i class="mdi mdi-trash-can"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% endif %}
    </div>
</div>
<div class="modal fade"
id="calendarModal">

<div class="modal-dialog modal-lg">

<div class="modal-content">

<div class="modal-header">

<h5>Calendrier formations</h5>

<button
class="btn-close"
data-bs-dismiss="modal">
</button>

</div>

<div class="modal-body">

<div id="calendar"></div>

</div>

</div>

</div>

</div>

{# ---------------- JS ---------------- #}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnGrid = document.getElementById('btn-grid');
        const btnList = document.getElementById('btn-list');
        const gridView = document.getElementById('grid-view');
        const listView = document.getElementById('list-view');

        function showGrid() {
            gridView.style.display = "";
            listView.style.display = "none";
            btnGrid.classList.replace('btn-outline-primary', 'btn-primary');
            btnList.classList.replace('btn-primary', 'btn-outline-primary');
        }

        function showList() {
            gridView.style.display = "none";
            listView.style.display = "";
            btnList.classList.replace('btn-outline-primary', 'btn-primary');
            btnGrid.classList.replace('btn-primary', 'btn-outline-primary');
        }

        btnGrid.addEventListener("click", showGrid);
        btnList.addEventListener("click", showList);

        showGrid(); // default
    });
</script>
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script>

document.addEventListener('DOMContentLoaded', function() {

var calendarEl = document.getElementById('calendar');

var calendar = new FullCalendar.Calendar(
calendarEl,
{

initialView:'dayGridMonth',

events:[
{% for f in formations %}{% if f.dateDebut %}
{ title:'{{ f.titre|e('js') }}', start:'{{ f.dateDebut|date("Y-m-d") }}', end:'{{ f.dateFin ? f.dateFin|date("Y-m-d") : f.dateDebut|date("Y-m-d") }}' },
{% endif %}{% endfor %}
]

});

document.getElementById('calendarModal')
.addEventListener('shown.bs.modal', function () {
    calendar.render();
});

});
</script>
{% endblock %}

