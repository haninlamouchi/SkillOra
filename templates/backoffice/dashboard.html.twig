{% extends 'backoffice/base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<!-- Promo Banner -->
<div class="row p-0 m-0 proBanner" id="proBanner">
    <div class="col-md-12 p-0 m-0">
        <div class="card-body card-body-padding px-3 d-flex align-items-center justify-content-between">
            <div class="ps-lg-3">
                <div class="d-flex align-items-center justify-content-between">
                    <p class="mb-0 fw-medium me-3 buy-now-text">🎓 Bienvenue sur le backoffice SkillOra</p>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <button id="bannerClose" class="btn border-0 p-0">
                    <i class="ti-close text-white"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mt-4">
    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex align-items-center align-self-start">
                            <h3 class="mb-0">{{ totalChallenges }}</h3>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="icon icon-box-success">
                            <span class="mdi mdi-trophy icon-item"></span>
                        </div>
                    </div>
                </div>
                <h6 class="text-muted font-weight-normal">Challenges</h6>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex align-items-center align-self-start">
                            <h3 class="mb-0">{{ totalParticipations }}</h3>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="icon icon-box-primary">
                            <span class="mdi mdi-account-multiple icon-item"></span>
                        </div>
                    </div>
                </div>
                <h6 class="text-muted font-weight-normal">Participations</h6>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex align-items-center align-self-start">
                            <h3 class="mb-0">{{ totalLivrables }}</h3>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="icon icon-box-warning">
                            <span class="mdi mdi-file-document icon-item"></span>
                        </div>
                    </div>
                </div>
                <h6 class="text-muted font-weight-normal">Livrables</h6>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex align-items-center align-self-start">
                            <h3 class="mb-0">{{ totalGroupes }}</h3>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="icon icon-box-info">
                            <span class="mdi mdi-account-group icon-item"></span>
                        </div>
                    </div>
                </div>
                <h6 class="text-muted font-weight-normal">Groupes</h6>
            </div>
        </div>
    </div>
</div>

<!-- Livrables Status -->
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">📊 Statut des Livrables</h4>
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="mb-0">En attente</p>
                            <p class="mb-0 text-warning">{{ livrablesEnAttente }}</p>
                        </div>
                        <div class="progress progress-md">
                            <div class="progress-bar bg-warning" role="progressbar" 
                                 style="width: {% if totalLivrables > 0 %}{{ (livrablesEnAttente / totalLivrables * 100)|round }}{% else %}0{% endif %}%"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="mb-0">Validés</p>
                            <p class="mb-0 text-success">{{ livrablesValides }}</p>
                        </div>
                        <div class="progress progress-md">
                            <div class="progress-bar bg-success" role="progressbar" 
                                 style="width: {% if totalLivrables > 0 %}{{ (livrablesValides / totalLivrables * 100)|round }}{% else %}0{% endif %}%"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="mb-0">Refusés</p>
                            <p class="mb-0 text-danger">{{ livrablesRefuses }}</p>
                        </div>
                        <div class="progress progress-md">
                            <div class="progress-bar bg-danger" role="progressbar" 
                                 style="width: {% if totalLivrables > 0 %}{{ (livrablesRefuses / totalLivrables * 100)|round }}{% else %}0{% endif %}%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Access -->
<div class="row">
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="mdi mdi-trophy" style="font-size: 48px; color: #4CAF50;"></i>
                <h5 class="mt-3">Gérer les Challenges</h5>
                <p class="text-muted">Voir tous les challenges créés</p>
                <a href="{{ path('admin_challenges') }}" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="mdi mdi-account-multiple" style="font-size: 48px; color: #2196F3;"></i>
                <h5 class="mt-3">Voir les Participations</h5>
                <p class="text-muted">Toutes les participations actives</p>
                <a href="{{ path('admin_participations') }}" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="mdi mdi-file-document" style="font-size: 48px; color: #FF9800;"></i>
                <h5 class="mt-3">Consulter les Livrables</h5>
                <p class="text-muted">Tous les livrables soumis</p>
                <a href="{{ path('admin_livrables') }}" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}