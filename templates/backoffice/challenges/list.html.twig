{% extends 'backoffice/base.html.twig' %}

{% block title %}Challenges - Admin{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">🏆 Liste des Challenges</h4>
                </div>
                
                {# Barre de recherche #}
                <form method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Rechercher un challenge..." value="{{ search }}">
                        <button class="btn btn-primary" type="submit">
                            <i class="mdi mdi-magnify"></i> Rechercher
                        </button>
                        {% if search %}
                            <a href="{{ path('admin_challenges') }}" class="btn btn-secondary">Réinitialiser</a>
                        {% endif %}
                    </div>
                </form>
                
                {% if challenges is empty %}
                    <div class="text-center py-5">
                        <i class="mdi mdi-trophy" style="font-size: 64px; color: #ccc;"></i>
                        <p class="text-muted mt-3">Aucun challenge trouvé</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Date début</th>
                                    <th>Date fin</th>
                                    <th>Participations</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for challenge in challenges %}
                                    <tr>
                                        <td>
                                            <strong>{{ challenge.titre }}</strong>
                                            <br>
                                            <small class="text-muted">{{ challenge.description|slice(0, 60) }}...</small>
                                        </td>
                                        <td>{{ challenge.dateDebut|date('d/m/Y') }}</td>
                                        <td>{{ challenge.dateFin|date('d/m/Y') }}</td>
                                        <td>
                                            <span class="badge badge-info">{{ challenge.participations|length }} groupes</span>
                                        </td>
                                        <td>
                                            {% if challenge.dateFin < date() %}
                                                <span class="badge badge-secondary">Terminé</span>
                                            {% elseif challenge.dateDebut > date() %}
                                                <span class="badge badge-warning">À venir</span>
                                            {% else %}
                                                <span class="badge badge-success">En cours</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="mt-3">
                        <p class="text-muted">Total : {{ challenges|length }} challenge(s)</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}