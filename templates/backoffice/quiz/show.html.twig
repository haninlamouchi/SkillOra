{% extends 'backoffice/base.html.twig' %}
{% block title %}{{ quiz.titre }} | Admin SkillOra{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<style>
:root { --sk-primary:#131212; --sk-primary-dark:#040404; --sk-primary-light:#1e1d1d; --sk-red:#bf0000; }
.fo-page { font-family:"Inter",sans-serif; color:#1e2130; }
.fo-hero { background:linear-gradient(135deg,#131212 0%,#2a0000 50%,#1e1d1d 100%); border-radius:18px; position:relative; overflow:hidden; padding:32px 36px; }
.fo-hero::before { content:''; position:absolute; top:-80px; right:-80px; width:380px; height:380px; background:radial-gradient(circle,rgba(191,0,0,.18) 0%,transparent 65%); pointer-events:none; }
.fo-hero::after { content:''; position:absolute; bottom:-50px; left:30%; width:250px; height:250px; background:radial-gradient(circle,rgba(139,0,0,.1) 0%,transparent 65%); pointer-events:none; }
.fo-hero-title { font-size:1.55rem; font-weight:700; line-height:1.3; color:#fff; letter-spacing:-.02em; }
.fo-breadcrumb a { color:rgba(255,255,255,.45); font-size:.76rem; text-decoration:none; transition:color .15s; }
.fo-breadcrumb a:hover { color:rgba(255,255,255,.7); }
.fo-breadcrumb-sep { color:rgba(255,255,255,.25); margin:0 6px; font-size:.7rem; }
.stat-chip { display:inline-flex; align-items:center; gap:5px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.12); border-radius:100px; padding:4px 12px; font-size:.75rem; color:rgba(255,255,255,.82); backdrop-filter:blur(8px); white-space:nowrap; font-weight:500; }
.stat-chip i { font-size:.85rem; opacity:.7; }
.pill-nav { background:#fff; border-radius:100px; padding:5px 6px; display:inline-flex; gap:2px; flex-wrap:nowrap; overflow-x:auto; max-width:100%; box-shadow:0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06); position:sticky; top:60px; z-index:100; scrollbar-width:none; }
.pill-nav::-webkit-scrollbar { display:none; }
.pill-nav a { display:inline-flex; align-items:center; gap:5px; color:#6b7280; font-size:.775rem; font-weight:600; text-decoration:none; padding:6px 14px; border-radius:100px; transition:all .2s; white-space:nowrap; }
.pill-nav a:hover { background:#f3f4f6; color:#374151; }
.pill-nav a.active { background:var(--sk-red); color:#fff; box-shadow:0 2px 10px rgba(191,0,0,.3); }
.pill-nav .cnt { background:currentColor; color:#fff; min-width:18px; height:18px; border-radius:100px; font-size:.65rem; font-weight:700; display:inline-flex; align-items:center; justify-content:center; padding:0 5px; opacity:.22; }
.pill-nav a.active .cnt { opacity:.35; }
.sec-anchor { display:none; }
.sec-anchor.active-section { display:block; }
.s-card { border:none !important; border-radius:16px !important; box-shadow:0 1px 3px rgba(0,0,0,.06),0 4px 20px rgba(0,0,0,.05) !important; overflow:hidden; }
.s-card-header { background:#fff; padding:16px 22px; border-bottom:1px solid #f1f2f6 !important; display:flex; align-items:center; gap:12px; }
.s-card-header .s-icon { width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.s-card-header .s-title { font-size:.925rem; font-weight:700; color:#1e2130; }
.s-card-header .s-cnt { font-size:.72rem; font-weight:600; padding:3px 9px; border-radius:100px; margin-left:6px; }
.ib-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; padding:20px; }
.ib { background:#f8f9fe; border-radius:12px; padding:14px 16px; border:1px solid #eef0f8; }
.ib-full { grid-column:1/-1; }
.ib .ib-label { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:#9298a8; font-weight:700; margin-bottom:5px; }
.ib .ib-val { font-size:.9rem; font-weight:500; color:#2d3142; }
.q-card { border:1px solid #eef0f8; border-radius:14px; overflow:hidden; margin-bottom:12px; }
.q-card:last-child { margin-bottom:0; }
.q-head { display:flex; align-items:center; gap:12px; padding:14px 18px; background:linear-gradient(135deg,#131212,#1e1d1d); }
.q-num { width:32px; height:32px; border-radius:50%; background:rgba(191,0,0,.8); color:#fff; font-weight:800; font-size:.8rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.q-text { font-size:.88rem; font-weight:600; color:#fff; flex:1; }
.q-pts { background:rgba(255,255,255,.12); color:rgba(255,255,255,.9); border-radius:100px; padding:2px 10px; font-size:.72rem; font-weight:700; white-space:nowrap; }
.q-actions { display:flex; gap:6px; }
.q-actions a, .q-actions button { width:30px; height:30px; border-radius:8px; border:none; display:inline-flex; align-items:center; justify-content:center; font-size:.82rem; cursor:pointer; transition:background .15s; text-decoration:none; }
.q-actions .btn-edit { background:rgba(255,255,255,.12); color:#fff; }
.q-actions .btn-edit:hover { background:rgba(255,255,255,.22); }
.q-actions .btn-del { background:rgba(191,0,0,.5); color:#fff; }
.q-actions .btn-del:hover { background:rgba(191,0,0,.8); }
.opt-list { padding:12px 16px; display:flex; flex-direction:column; gap:8px; background:#fff; }
.opt-item { display:flex; align-items:center; gap:10px; padding:9px 14px; border-radius:10px; border:1px solid #eef0f8; background:#f8f9fe; font-size:.84rem; color:#374151; }
.opt-item.correct { background:rgba(34,197,94,.06); border-color:rgba(34,197,94,.3); }
.opt-badge { width:24px; height:24px; border-radius:6px; background:#e5e7eb; color:#6b7280; font-weight:800; font-size:.7rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; }
.opt-item.correct .opt-badge { background:#16a34a; color:#fff; }
.opt-check { margin-left:auto; color:#16a34a; font-size:.9rem; }
.av { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--sk-primary),var(--sk-red)); color:#fff; font-weight:700; font-size:.78rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.av-sm { width:28px; height:28px; font-size:.68rem; }
.micro-bar { height:5px; border-radius:3px; background:#eef0f8; overflow:hidden; margin-top:3px; }
.micro-fill { height:100%; border-radius:3px; transition:width .4s; }
.fo-table thead th { background:linear-gradient(135deg,var(--sk-primary),var(--sk-primary-light)); color:#fff; font-size:.71rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; padding-top:14px; padding-bottom:14px; border:none; }
.fo-table tbody tr { transition:background .15s; }
.fo-table tbody tr:hover { background:#fdf2f2; }
.fo-table td { padding-top:13px; padding-bottom:13px; border-color:#f0f0f0; vertical-align:middle; }
.rank-dot { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.72rem; font-weight:700; flex-shrink:0; margin:0 auto; }
.rank-1 { background:linear-gradient(135deg,#ffd700,#f59e0b); color:#7c4c00; box-shadow:0 2px 8px rgba(245,158,11,.3); }
.rank-2 { background:linear-gradient(135deg,#e2e8f0,#cbd5e1); color:#475569; }
.rank-3 { background:linear-gradient(135deg,#fecaca,#fca5a5); color:#991b1b; }
.rank-n { background:#f3f4f6; color:#9ca3af; }
</style>
{% endblock %}

{% block body %}
<div class="fo-page">

{% for type, messages in app.flashes %}
  {% for message in messages %}
  <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
    <i class="mdi mdi-{{ type == 'success' ? 'check-circle-outline' : 'alert-circle-outline' }} fs-6"></i>
    <span>{{ message }}</span>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
  </div>
  {% endfor %}
{% endfor %}


{# ══════════════════════════════════════
   HERO
══════════════════════════════════════ #}
{% set totalPoints = 0 %}
{% for q in quiz.questions %}{% set totalPoints = totalPoints + (q.points ?? 1) %}{% endfor %}

<div class="fo-hero mb-4">
  <div class="fo-breadcrumb mb-2">
    <a href="{{ path('admin_dashboard') }}">Dashboard</a>
    <span class="fo-breadcrumb-sep">›</span>
    <a href="{{ path('admin_formation_show', {id: formation.id}) }}">{{ formation.titre|slice(0,40) }}{% if formation.titre|length > 40 %}…{% endif %}</a>
    <span class="fo-breadcrumb-sep">›</span>
    <span style="color:rgba(255,255,255,.7)">{{ quiz.titre|slice(0,35) }}{% if quiz.titre|length > 35 %}…{% endif %}</span>
  </div>
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
      <div class="fo-hero-title mb-3 d-flex align-items-center gap-2">
        <i class="mdi mdi-help-circle" style="font-size:1.4rem;color:rgba(255,255,255,.55)"></i>
        {{ quiz.titre }}
      </div>
      <div class="d-flex flex-wrap gap-2">
        <span class="stat-chip"><i class="mdi mdi-format-list-numbered"></i> {{ quiz.questions|length }} question{{ quiz.questions|length != 1 ? 's' : '' }}</span>
        <span class="stat-chip"><i class="mdi mdi-clock-outline"></i> {{ quiz.duree ? quiz.duree ~ ' min' : 'Durée libre' }}</span>
        <span class="stat-chip"><i class="mdi mdi-star-outline"></i> {{ totalPoints }} pts</span>
        <span class="stat-chip"><i class="mdi mdi-account-check-outline"></i> {{ quizResults|length }} résultat{{ quizResults|length != 1 ? 's' : '' }}</span>
        {% if quiz.level is defined and quiz.level %}
          <span class="stat-chip"><i class="mdi mdi-signal"></i> Niveau {{ quiz.level.numero }}</span>
        {% endif %}
      </div>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
      <a href="{{ path('admin_quiz_edit', {formationId: formation.id, id: quiz.id}) }}"
         class="btn btn-sm d-inline-flex align-items-center gap-1"
         style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:8px">
        <i class="mdi mdi-pencil-outline"></i> Modifier
      </a>
      <a href="{{ path('admin_formation_show', {id: formation.id}) }}"
         class="btn btn-sm d-inline-flex align-items-center gap-1"
         style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.7);border-radius:8px">
        <i class="mdi mdi-arrow-left"></i> Retour
      </a>
    </div>
  </div>
</div>

{# ══════════════════════════════════════
   PILL NAV
══════════════════════════════════════ #}
<div class="mb-4">
  <div class="pill-nav">
    <a href="#" data-sec="sec-details" class="active">
      <i class="mdi mdi-information-outline"></i> Détails
    </a>
    <a href="#" data-sec="sec-questions">
      <i class="mdi mdi-format-list-numbered"></i> Questions
      <span class="cnt">{{ quiz.questions|length }}</span>
    </a>
    <a href="#" data-sec="sec-resultats">
      <i class="mdi mdi-chart-box-outline"></i> Résultats
      <span class="cnt">{{ quizResults|length }}</span>
    </a>
  </div>
</div>

{# ══════════════════════════════════════
   SECTION — DÉTAILS
══════════════════════════════════════ #}
<div id="sec-details" class="sec-anchor active-section">
  <div class="card s-card">
    <div class="s-card-header">
      <div class="s-icon" style="background:rgba(191,0,0,.1)"><i class="mdi mdi-information-outline" style="color:var(--sk-red)"></i></div>
      <span class="s-title">Informations générales</span>
    </div>
    <div class="ib-grid">
      {% if quiz.description %}
      <div class="ib ib-full">
        <div class="ib-label">Description</div>
        <div class="ib-val">{{ quiz.description }}</div>
      </div>
      {% endif %}
      <div class="ib">
        <div class="ib-label">Durée</div>
        <div class="ib-val">{{ quiz.duree ? quiz.duree ~ ' minutes' : 'Non définie' }}</div>
      </div>
      <div class="ib">
        <div class="ib-label">Nb de questions</div>
        <div class="ib-val">{{ quiz.questions|length }}</div>
      </div>
      <div class="ib">
        <div class="ib-label">Total des points</div>
        <div class="ib-val">{{ totalPoints }} pts</div>
      </div>
      {% if quiz.level is defined and quiz.level %}
      <div class="ib">
        <div class="ib-label">Niveau</div>
        <div class="ib-val">Niveau {{ quiz.level.numero }}</div>
      </div>
      {% endif %}
      <div class="ib">
        <div class="ib-label">Formation</div>
        <div class="ib-val">
          <a href="{{ path('admin_formation_show', {id: formation.id}) }}" style="color:var(--sk-red);text-decoration:none">{{ formation.titre }}</a>
        </div>
      </div>
      <div class="ib">
        <div class="ib-label">Participations</div>
        <div class="ib-val">{{ quizResults|length }}</div>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════
   SECTION — QUESTIONS
══════════════════════════════════════ #}
<div id="sec-questions" class="sec-anchor">
  <div class="card s-card">
    <div class="s-card-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="s-icon" style="background:rgba(191,0,0,.1)"><i class="mdi mdi-format-list-numbered" style="color:var(--sk-red)"></i></div>
        <span class="s-title">Questions</span>
        <span class="s-cnt" style="background:rgba(191,0,0,.1);color:var(--sk-red)">{{ quiz.questions|length }}</span>
      </div>
      <a href="{{ path('admin_question_new', {formationId: formation.id, quizId: quiz.id}) }}"
         class="btn btn-sm d-inline-flex align-items-center gap-1"
         style="background:var(--sk-red);color:#fff;border:none;border-radius:8px">
        <i class="mdi mdi-plus"></i> Ajouter
      </a>
    </div>
    <div class="p-4">
      {% if quiz.questions|length > 0 %}
        {% set letters = ['A','B','C','D','E','F'] %}
        {% for question in quiz.questions %}
        <div class="q-card">
          <div class="q-head">
            <div class="q-num">{{ loop.index }}</div>
            <div class="q-text">{{ question.contenu }}</div>
            <div class="q-pts">{{ question.points ?? 1 }} pt{{ (question.points ?? 1) > 1 ? 's' : '' }}</div>
            <div class="q-actions">
              <a href="{{ path('admin_question_edit', {formationId: formation.id, quizId: quiz.id, id: question.id}) }}" class="btn-edit" title="Modifier">
                <i class="mdi mdi-pencil-outline"></i>
              </a>
              <form action="{{ path('admin_question_delete', {formationId: formation.id, quizId: quiz.id, id: question.id}) }}" method="post" style="display:contents" onsubmit="return confirm('Supprimer cette question ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_question' ~ question.id) }}">
                <button type="submit" class="btn-del" title="Supprimer"><i class="mdi mdi-trash-can-outline"></i></button>
              </form>
            </div>
          </div>
          <div class="opt-list">
            {% for option in question.optionQuestions %}
            <div class="opt-item {{ option.estCorrect ? 'correct' : '' }}">
              <div class="opt-badge">{{ letters[loop.index0] ?? loop.index }}</div>
              <span>{{ option.contenu }}</span>
              {% if option.estCorrect %}<i class="mdi mdi-check-circle opt-check"></i>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <div class="text-center py-5" style="color:#9ca3af">
          <i class="mdi mdi-help-box-outline" style="font-size:3rem;opacity:.3;display:block;margin-bottom:10px"></i>
          <p class="mb-3">Aucune question dans ce quiz.</p>
          <a href="{{ path('admin_question_new', {formationId: formation.id, quizId: quiz.id}) }}"
             class="btn btn-sm" style="background:var(--sk-red);color:#fff;border-radius:8px">
            <i class="mdi mdi-plus"></i> Ajouter la première question
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{# ══════════════════════════════════════
   SECTION — RÉSULTATS
══════════════════════════════════════ #}
<div id="sec-resultats" class="sec-anchor">
  <div class="card s-card">
    <div class="s-card-header">
      <div class="s-icon" style="background:rgba(191,0,0,.1)"><i class="mdi mdi-chart-box-outline" style="color:var(--sk-red)"></i></div>
      <span class="s-title">Résultats des participants</span>
      <span class="s-cnt" style="background:rgba(191,0,0,.1);color:var(--sk-red)">{{ quizResults|length }}</span>
    </div>
    {% if quizResults|length > 0 %}
    <div class="table-responsive">
      <table class="table fo-table mb-0">
        <thead>
          <tr>
            <th class="ps-4" style="width:54px">Rang</th>
            <th>Participant</th>
            <th class="text-center">Score</th>
            <th class="text-center">Résultat</th>
            <th class="pe-4 text-end">Date</th>
          </tr>
        </thead>
        <tbody>
          {% set sortedResults = quizResults|sort((a,b) => b.score <=> a.score) %}
          {% for res in sortedResults %}
          {% set pct = totalPoints > 0 ? (res.score / totalPoints * 100)|round : 0 %}
          <tr>
            <td class="ps-4 text-center">
              {% if loop.index == 1 %}
                <div class="rank-dot rank-1">1</div>
              {% elseif loop.index == 2 %}
                <div class="rank-dot rank-2">2</div>
              {% elseif loop.index == 3 %}
                <div class="rank-dot rank-3">3</div>
              {% else %}
                <div class="rank-dot rank-n">{{ loop.index }}</div>
              {% endif %}
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="av av-sm">{{ res.user.fullName|first|upper }}</div>
                <div>
                  <div style="font-weight:600;font-size:.84rem">{{ res.user.fullName }}</div>
                  <div style="font-size:.72rem;color:#9ca3af">{{ res.user.email }}</div>
                </div>
              </div>
            </td>
            <td class="text-center">
              <div style="font-weight:700;font-size:.9rem">{{ res.score }} / {{ totalPoints }}</div>
              <div class="micro-bar" style="width:72px;margin:3px auto 0">
                <div class="micro-fill" style="width:{{ pct }}%;background:{{ pct >= 70 ? '#22c55e' : (pct >= 50 ? '#f59e0b' : '#ef4444') }}"></div>
              </div>
            </td>
            <td class="text-center">
              {% if pct >= 70 %}
                <span class="badge rounded-pill" style="background:rgba(34,197,94,.15);color:#16a34a;font-size:.7rem;font-weight:700;padding:4px 10px">{{ pct }}% ✓</span>
              {% elseif pct >= 50 %}
                <span class="badge rounded-pill" style="background:rgba(245,158,11,.15);color:#d97706;font-size:.7rem;font-weight:700;padding:4px 10px">{{ pct }}%</span>
              {% else %}
                <span class="badge rounded-pill" style="background:rgba(239,68,68,.12);color:#dc2626;font-size:.7rem;font-weight:700;padding:4px 10px">{{ pct }}%</span>
              {% endif %}
            </td>
            <td class="pe-4 text-end" style="font-size:.78rem;color:#9ca3af">
              {{ res.datePassage|date('d/m/Y') }}<br>
              <span style="font-size:.7rem">{{ res.datePassage|date('H:i') }}</span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="text-center py-5" style="color:#9ca3af">
      <i class="mdi mdi-account-off-outline" style="font-size:3rem;opacity:.3;display:block;margin-bottom:10px"></i>
      <p class="mb-0">Aucun participant n'a encore passé ce quiz.</p>
    </div>
    {% endif %}
  </div>
</div>

</div>{# /fo-page #}
{% endblock %}

{% block javascripts %}
<script>
(function(){
  const links = document.querySelectorAll('.pill-nav a[data-sec]');
  const secs  = document.querySelectorAll('.sec-anchor');
  function activate(id){
    secs.forEach(s => s.classList.remove('active-section'));
    links.forEach(l => l.classList.remove('active'));
    const sec = document.getElementById(id);
    if(sec) sec.classList.add('active-section');
    links.forEach(l => { if(l.dataset.sec === id) l.classList.add('active'); });
    history.replaceState(null,'','#'+id);
  }
  links.forEach(l => l.addEventListener('click', e => { e.preventDefault(); activate(l.dataset.sec); }));
  const hash = location.hash.replace('#','');
  if(hash && document.getElementById(hash)) activate(hash);
})();
</script>
{% endblock %}
