{% extends 'backoffice/base.html.twig' %}

{% block title %}Formations | Skillora Admin{% endblock %}

{% block styles %}
<style>
    .stat-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }
    .badge-status { font-size: 0.72rem; padding: 0.35em 0.65em; }
    .empty-state-icon { font-size: 4rem; opacity: 0.15; }
    .btn-action { font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.375rem; transition: all 0.15s ease; }
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* ── Formation Cards ── */
    .formation-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        background: #fff;
        height: 100%;
    }
    .formation-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(90,0,0,0.12);
    }
    .formation-card .card-img-top { height: 160px; object-fit: cover; }
    .formation-card .card-img-placeholder {
        height: 160px;
        background: linear-gradient(135deg, #f5f5f5, #ede0e0);
        display: flex; align-items: center; justify-content: center;
        color: #c0a0a0; font-size: 2.5rem;
    }
    .formation-card .card-body { padding: 1.2rem; display: flex; flex-direction: column; }
    .formation-card .card-title { font-weight: 700; font-size: 1rem; color: #222; margin-bottom: 0.3rem; }
    .formation-card .card-desc { font-size: 0.82rem; color: #777; line-height: 1.55; flex-grow: 1; }
    .formation-card .card-footer-meta {
        border-top: 1px solid #f0f0f0;
        padding-top: 0.8rem;
        margin-top: 0.8rem;
        display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;
    }
    .hidden-card { display: none !important; }
</style>
{% endblock %}

{% block body %}
<main class="admin-content">
    <div class="container-fluid px-4">

        {# ── Flash messages ── #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show mt-3 fade-in" role="alert">
                    <i class="bi bi-{{ type == 'success' ? 'check-circle' : (type == 'warning' ? 'exclamation-triangle' : 'x-circle') }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# ── Page header ── #}
        <div class="mb-4 fade-in">
            <div class="row align-items-center">
                <div class="col">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb breadcrumb-sm mb-1">
                            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Formations</li>
                        </ol>
                    </nav>
                    <h1 class="page-title">Formations</h1>
                    <p class="page-subtitle">Gérez les parcours d'apprentissage disponibles sur votre plateforme.</p>
                </div>
                <div class="col-auto">
                    <a href="{{ path('app_formation_new') }}" class="btn btn-skillora">
                        <i class="bi bi-plus-lg me-1"></i> Nouvelle Formation
                    </a>
                </div>
            </div>
        </div>

        {# ── Dynamic Stats ── #}
        {% set totalParticipants = 0 %}
        {% set totalVideos = 0 %}
        {% set activeCount = 0 %}
        {% set completedCount = 0 %}
        {% for f in formations %}
            {% set totalParticipants = totalParticipants + f.participations|length %}
            {% set totalVideos = totalVideos + f.videos|length %}
            {% if f.dateFin is null or f.dateFin|date('Y-m-d') >= 'now'|date('Y-m-d') %}
                {% set activeCount = activeCount + 1 %}
            {% else %}
                {% set completedCount = completedCount + 1 %}
            {% endif %}
        {% endfor %}

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon bg-skillora-soft"><i class="bi bi-book"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">{{ formations|length }}</span>
                        <span class="stat-label">Total Formations</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info-soft"><i class="bi bi-people"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">{{ totalParticipants }}</span>
                        <span class="stat-label">Participants inscrits</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft"><i class="bi bi-camera-video"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">{{ totalVideos }}</span>
                        <span class="stat-label">Total Vidéos</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft"><i class="bi bi-clock-history"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">{{ activeCount }}</span>
                        <span class="stat-label">En cours</span>
                    </div>
                </div>
            </div>
        </div>

        {# ── Formations Grid ── #}
        <div class="fade-in">
            {# Toolbar #}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h2 class="mb-0" style="font-size:1.15rem; font-weight:700; color:#333;">
                    <i class="bi bi-journal-text me-2 text-skillora"></i>Liste des Formations
                </h2>
                <div class="d-flex gap-2 align-items-center">
                    <div class="input-group input-group-sm" style="width: 240px">
                        <span class="input-group-text border-end-0 bg-transparent"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Rechercher..." id="searchFormation">
                    </div>
                    <select class="form-select form-select-sm" id="filterStatus" style="width: 140px">
                        <option value="all">Tous statuts</option>
                        <option value="active">En cours</option>
                        <option value="completed">Terminée</option>
                    </select>
                </div>
            </div>

            {# Grid #}
            <div class="row g-4" id="formationsGrid">
                {% for f in formations %}
                {% set isActive = f.dateFin is null or f.dateFin|date('Y-m-d') >= 'now'|date('Y-m-d') %}
                <div class="col-sm-6 col-lg-4 col-xl-3 formation-item"
                     data-status="{{ isActive ? 'active' : 'completed' }}"
                     data-title="{{ f.titre|lower }}">
                    <div class="formation-card">
                        {# Image #}
                        {% if f.image %}
                            <img src="{{ f.image }}" class="card-img-top" alt="{{ f.titre }}">
                        {% else %}
                            <div class="card-img-placeholder">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                        {% endif %}

                        <div class="card-body">
                            {# Status badge #}
                            <div class="mb-2">
                                {% if isActive %}
                                    <span class="badge bg-success badge-status">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.45rem;vertical-align:middle"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary badge-status">
                                        <i class="bi bi-check-circle me-1"></i>Terminée
                                    </span>
                                {% endif %}
                                {% if f.club %}
                                    <span class="badge bg-skillora-soft text-skillora badge-status ms-1">{{ f.club }}</span>
                                {% endif %}
                            </div>

                            {# Title #}
                            <h5 class="card-title">
                                <a href="{{ path('app_formation_show', {id: f.id}) }}" class="text-decoration-none text-dark stretched-link-title">
                                    {{ f.titre }}
                                </a>
                            </h5>

                            {# Description #}
                            <p class="card-desc">
                                {{ f.description|length > 80 ? f.description|slice(0, 80) ~ '…' : (f.description ?? 'Aucune description.') }}
                            </p>

                            {# Meta: date, videos, participants #}
                            <div class="card-footer-meta">
                                {% if f.dateDebut %}
                                    <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>{{ f.dateDebut|date('d/m/Y') }}</span>
                                {% endif %}
                                <span class="badge bg-info badge-status ms-auto">
                                    <i class="bi bi-play-btn me-1"></i>{{ f.videos|length }}
                                </span>
                                <span class="badge bg-primary badge-status">
                                    <i class="bi bi-people me-1"></i>{{ f.participations|length }}
                                </span>
                            </div>

                            {# Actions #}
                            <div class="d-flex gap-1 mt-3">
                                <a href="{{ path('app_formation_show', {id: f.id}) }}"
                                   class="btn btn-outline-primary btn-action flex-fill text-center" title="Détails">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_formation_edit', {id: f.id}) }}"
                                   class="btn btn-outline-warning btn-action flex-fill text-center" title="Modifier">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-outline-danger btn-action flex-fill"
                                        title="Supprimer"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-formation-id="{{ f.id }}"
                                        data-formation-title="{{ f.titre }}"
                                        data-delete-url="{{ path('app_formation_delete', {id: f.id}) }}"
                                        data-csrf-token="{{ csrf_token('delete' ~ f.id) }}">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-12 text-center py-5 text-muted" id="emptyRow">
                    <i class="bi bi-inbox empty-state-icon d-block mb-2"></i>
                    <p class="mb-2">Aucune formation trouvée.</p>
                    <a href="{{ path('app_formation_new') }}" class="btn btn-skillora btn-sm">
                        <i class="bi bi-plus-lg me-1"></i> Créer votre première formation
                    </a>
                </div>
                {% endfor %}
            </div>

            {# Empty state shown by JS #}
            <div id="emptyState" class="text-center py-5 text-muted" style="display:none;">
                <i class="bi bi-search empty-state-icon d-block mb-2"></i>
                <p class="mb-0">Aucune formation ne correspond à vos critères.</p>
            </div>

            <div class="mt-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small" id="resultCount">
                    Affichage de {{ formations|length }} formation{{ formations|length != 1 ? 's' : '' }}
                </span>
                <span class="text-muted small">
                    {{ activeCount }} active{{ activeCount != 1 ? 's' : '' }} &middot; {{ completedCount }} terminée{{ completedCount != 1 ? 's' : '' }}
                </span>
            </div>
        </div>

    </div>
</main>

{# ── Delete Confirmation Modal ── #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer la formation <strong id="deleteFormationTitle"></strong> ?</p>
                <p class="text-muted small mb-0">Cette action est irréversible. Toutes les vidéos et participations associées seront également supprimées.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="deleteForm" method="post">
                    <input type="hidden" name="_token" id="deleteCsrfToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3 me-1"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput  = document.getElementById('searchFormation');
    const filterSelect = document.getElementById('filterStatus');
    const items        = document.querySelectorAll('.formation-item');
    const resultCount  = document.getElementById('resultCount');
    const emptyState   = document.getElementById('emptyState');
    const grid         = document.getElementById('formationsGrid');

    function applyFilters() {
        const search = searchInput.value.toLowerCase().trim();
        const status = filterSelect.value;
        let visible = 0;

        items.forEach(item => {
            const title     = item.dataset.title || '';
            const rowStatus = item.dataset.status;
            const matchSearch = !search || title.includes(search) || item.textContent.toLowerCase().includes(search);
            const matchStatus = status === 'all' || rowStatus === status;

            if (matchSearch && matchStatus) {
                item.classList.remove('hidden-card');
                visible++;
            } else {
                item.classList.add('hidden-card');
            }
        });

        resultCount.textContent = visible + ' formation' + (visible !== 1 ? 's' : '') + ' affichée' + (visible !== 1 ? 's' : '');
        if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
        if (grid) grid.style.display = visible === 0 ? 'none' : '';
    }

    searchInput?.addEventListener('input', applyFilters);
    filterSelect?.addEventListener('change', applyFilters);

    // ── Delete Modal ──
    const deleteModal = document.getElementById('deleteModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('deleteFormationTitle').textContent = btn.dataset.formationTitle;
            document.getElementById('deleteForm').action = btn.dataset.deleteUrl;
            document.getElementById('deleteCsrfToken').value = btn.dataset.csrfToken;
        });
    }

    // ── Auto-dismiss flash messages after 5s ──
    document.querySelectorAll('.alert-dismissible').forEach(alert => {
        setTimeout(() => {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
            bsAlert.close();
        }, 5000);
    });
});
</script>
{% endblock %}
