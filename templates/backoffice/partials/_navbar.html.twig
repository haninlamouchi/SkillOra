  {# ===== STYLES POUR STABILISER LE DROPDOWN ===== #}
  <style>
    #profileDropdownWrapper .dropdown-menu {
      margin-top: 0 !important;
      z-index: 9999 !important;
      display: block;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    #profileDropdownWrapper .dropdown-menu.show {
      visibility: visible;
      opacity: 1;
      pointer-events: all;
    }
  </style>

  {# ===== SCRIPTS ===== #}
  <script>
    // --- Fix dropdown profil instable ---
    (function () {
      var wrapper = document.getElementById('profileDropdownWrapper');
      var toggle  = document.getElementById('UserDropdown');
      var menu    = document.getElementById('profileDropdownMenu');

      if (!wrapper || !toggle || !menu) return;

      // Empêche la fermeture quand la souris passe dans le menu
      menu.addEventListener('click', function (e) {
        e.stopPropagation();
      });

      // Ré-ouvre si Bootstrap ferme trop vite
      toggle.addEventListener('shown.bs.dropdown', function () {
        menu.classList.add('show');
      });

      toggle.addEventListener('hidden.bs.dropdown', function () {
        menu.classList.remove('show');
      });
    })();

    // --- Recherche admin ---
    function handleAdminSearch(e) {
      e.preventDefault();
      var q    = document.getElementById('adminSearchInput').value.trim();
      var path = window.location.pathname;
      var target = '';
      if (path.indexOf('/admin/forum/commentaires') !== -1) {
        target = '{{ path("admin_forum_commentaires") }}';
      } else if (path.indexOf('/admin/forum') !== -1) {
        target = '{{ path("admin_forum_publications") }}';
      } else {
        target = '{{ path("admin_forum_publications") }}';
      }
      window.location.href = target + '?q=' + encodeURIComponent(q);
      return false;
    }

    // --- Restaure la valeur de recherche dans l'input ---
    (function () {
      var params = new URLSearchParams(window.location.search);
      var q = params.get('q');
      if (q) {
        var input = document.getElementById('adminSearchInput');
        if (input) input.value = q;
      }
    })();
  </script>

