{% extends 'backoffice/base.html.twig' %}

{% block title %}Modifier la Question | Skillora Admin{% endblock %}

{% block body %}
<main class="admin-content">
    <div class="container-fluid px-4">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show mt-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Breadcrumb #}
        <div class="mb-4 mt-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-sm mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_formation_index') }}">Formations</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_formation_show', {id: formation.id}) }}">{{ formation.titre }}</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_quiz_show', {formationId: formation.id, id: quiz.id}) }}">{{ quiz.titre }}</a></li>
                    <li class="breadcrumb-item active">Modifier la question</li>
                </ol>
            </nav>
            <h1 class="page-title"><i class="bi bi-pencil-square me-2"></i>Modifier la Question</h1>
            <p class="text-muted mb-0">Quiz : <strong>{{ quiz.titre }}</strong></p>
        </div>

        {# Question Form #}
        <div class="row justify-content-center">
            <div class="col-lg-9">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'question-form'}}) }}

                {% if form.vars.submitted and not form.vars.valid %}
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Veuillez corriger les erreurs indiquées ci-dessous avant de continuer.</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endif %}

                {# Question content + points #}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-question-circle me-2"></i>Intitulé de la Question</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-9">
                                {{ form_row(form.contenu) }}
                            </div>
                            <div class="col-md-3">
                                {{ form_row(form.points) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Options (4 choices, A/B/C/D) #}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Options de réponse</h5>
                        <small class="text-muted">Cochez la ou les réponses correctes.</small>
                    </div>
                    <div class="card-body">
                        {% set letters = ['A', 'B', 'C', 'D'] %}
                        {% for optionForm in form.optionQuestions %}
                        <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded border option-row">
                            <span class="badge bg-primary fs-6" style="width:36px;height:36px;line-height:24px;text-align:center">{{ letters[loop.index0] ?? loop.index }}</span>
                            <div class="flex-grow-1">
                                {{ form_widget(optionForm.contenu, {'attr': {'placeholder': 'Texte de l\'option ' ~ (letters[loop.index0] ?? loop.index) ~ '...'}}) }}
                                {{ form_errors(optionForm.contenu) }}
                            </div>
                            <div class="form-check">
                                {{ form_widget(optionForm.estCorrect, {'attr': {'class': 'form-check-input correct-check'}}) }}
                                <label class="form-check-label small text-success fw-semibold">Correcte</label>
                            </div>
                            {{ form_widget(optionForm.ordre) }}
                        </div>
                        {% endfor %}
                    </div>
                </div>

                {# Submit buttons #}
                <div class="d-flex justify-content-between mb-5">
                    <a href="{{ path('app_quiz_show', {formationId: formation.id, id: quiz.id}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-skillora px-4">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</main>
{% endblock %}

{% block styles %}
<style>
    .option-row { transition: all 0.2s; }
    .option-row:hover { background-color: #f8f9fa; }
    .correct-check:checked ~ label { color: #198754 !important; }
    .option-row:has(.correct-check:checked) {
        border-color: #198754 !important;
        background-color: #d1e7dd;
    }
</style>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    function showInlineError(field, message) {
        field.classList.add('is-invalid');
        var fb = field.parentNode.querySelector('.js-invalid-fb');
        if (!fb) {
            fb = document.createElement('div');
            fb.className = 'invalid-feedback d-block js-invalid-fb';
            field.parentNode.appendChild(fb);
        }
        fb.textContent = message;
    }

    function clearErrors() {
        document.querySelectorAll('.is-invalid').forEach(function(el) { el.classList.remove('is-invalid'); });
        document.querySelectorAll('.js-invalid-fb').forEach(function(el) { el.remove(); });
        var banner = document.getElementById('js-error-banner');
        if (banner) banner.remove();
    }

    function showBanner(form) {
        if (document.getElementById('js-error-banner')) return;
        var banner = document.createElement('div');
        banner.id = 'js-error-banner';
        banner.className = 'alert alert-danger alert-dismissible fade show mb-3';
        banner.setAttribute('role', 'alert');
        banner.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i>'
            + '<strong>Veuillez corriger les erreurs indiquées ci-dessous.</strong>'
            + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        form.prepend(banner);
    }

    document.querySelector('.question-form').addEventListener('submit', function(e) {
        clearErrors();
        var valid = true;
        var form = this;

        var contenu = document.getElementById('question_contenu');
        if (!contenu || contenu.value.trim() === '') {
            e.preventDefault();
            valid = false;
            if (contenu) showInlineError(contenu, "L'intitulé de la question est obligatoire.");
            showBanner(form);
        }

        var options = document.querySelectorAll('[id^="question_optionQuestions_"][id$="_contenu"]');
        options.forEach(function(opt, i) {
            if (opt.value.trim() === '') {
                e.preventDefault();
                valid = false;
                showInlineError(opt, "Le texte de l'option " + String.fromCharCode(65 + i) + ' est obligatoire.');
                showBanner(form);
            }
        });

        if (valid && document.querySelectorAll('.correct-check:checked').length === 0) {
            e.preventDefault();
            showBanner(form);
            document.getElementById('js-error-banner').querySelector('strong').textContent =
                'Veuillez cocher au moins une réponse correcte parmi les options.';
        }
    });
});
</script>
{% endblock %}
