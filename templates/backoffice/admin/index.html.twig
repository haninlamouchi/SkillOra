{% extends 'backoffice/base.html.twig' %}
{% block title %}Clubs | Admin{% endblock %}

{% block stylesheets %}
<style>
.club-logo { width:80px; height:40px; object-fit:contain; border-radius:6px; border:1px solid #eee; background:#fafafa; }
.no-logo {
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg,#c10609,#8b0507);
    color:#fff; font-weight:800; font-size:0.82rem;
    display:flex; align-items:center; justify-content:center;
}
.table tbody tr { cursor:default; transition:background 0.15s; }
.table tbody tr:hover { background:rgba(193,6,9,0.04) !important; }
.count-badge { background:#c10609; color:#fff; padding:4px 12px; border-radius:20px; font-size:0.72rem; font-weight:800; }

/* Pagination */
.pagination { justify-content:center; gap:4px; }
.pagination .page-link {
    border-radius:8px !important;
    border:1.5px solid #e4e4e4;
    color:#c10609;
    font-size:0.82rem;
    font-weight:600;
    padding:6px 12px;
    transition:all 0.2s;
}
.pagination .page-link:hover { background:#c10609; color:#fff; border-color:#c10609; }
.pagination .page-item.active .page-link { background:#c10609; border-color:#c10609; color:#fff; }
.pagination .page-item.disabled .page-link { color:#bbb; pointer-events:none; }

/* Search bar */
.search-wrap {
    background:#f9f9f9;
    border:1px solid #efefef;
    border-radius:10px;
    padding:16px 20px;
    margin-bottom:20px;
}
.search-label {
    font-size:0.65rem; font-weight:700;
    letter-spacing:2px; text-transform:uppercase;
    color:#6b6b6b; margin-bottom:6px;
    display:block;
}
.search-wrap .form-control {
    border-color:#e4e4e4;
    border-radius:8px;
    font-size:0.85rem;
}
.search-wrap .form-control:focus {
    border-color:#c10609;
    box-shadow:0 0 0 3px rgba(193,6,9,0.08);
}
.search-wrap .input-group-text {
    background:#f5f5f5;
    border-color:#e4e4e4;
    border-radius:8px 0 0 8px;
}
.btn-search {
    background:#c10609; color:#fff;
    font-weight:700; font-size:0.82rem;
    padding:8px 20px; border-radius:8px;
    border:none; transition:all 0.2s;
    white-space:nowrap;
}
.btn-search:hover { background:#8b0507; color:#fff; transform:translateY(-1px); }
.btn-reset {
    font-size:0.82rem; font-weight:600;
    padding:8px 14px; border-radius:8px;
    white-space:nowrap;
}
.filter-badge {
    display:inline-flex; align-items:center; gap:5px;
    background:rgba(193,6,9,0.08); color:#c10609;
    padding:3px 10px; border-radius:20px;
    font-size:0.72rem; font-weight:700;
}
</style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card" style="border-radius:12px; border-top:3px solid #c10609;">
            <div class="card-body">

                {# ── Flash messages ── #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# ── Titre ── #}
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <h4 class="card-title mb-0">
                        <i class="mdi mdi-shield-star me-2" style="color:#c10609;"></i>
                        Clubs
                        <span class="count-badge ms-2">{{ clubs.getTotalItemCount }}</span>
                    </h4>
                </div>

                {# ── Barre de recherche ── #}
                <form method="get" action="{{ path('admin_club_index') }}" class="search-wrap">
                    <div class="row g-2 align-items-end">

                        <div class="col-md-4">
                            <label class="search-label">Nom du club</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="mdi mdi-shield-search" style="color:#c10609;"></i>
                                </span>
                                <input type="text"
                                       name="nom"
                                       value="{{ searchNom }}"
                                       placeholder="Rechercher un club…"
                                       class="form-control">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="search-label">Responsable</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="mdi mdi-account-search" style="color:#c10609;"></i>
                                </span>
                                <input type="text"
                                       name="responsable"
                                       value="{{ searchResp }}"
                                       placeholder="Nom ou prénom…"
                                       class="form-control">
                            </div>
                        </div>

                        <div class="col-md-auto d-flex gap-2">
                            <button type="submit" class="btn-search">
                                <i class="mdi mdi-magnify me-1"></i> Rechercher
                            </button>
                            {% if searchNom != '' or searchResp != '' %}
                                <a href="{{ path('admin_club_index') }}"
                                   class="btn btn-outline-secondary btn-reset">
                                    <i class="mdi mdi-close me-1"></i> Réinitialiser
                                </a>
                            {% endif %}
                        </div>

                    </div>

                    {# ── Résumé des filtres actifs ── #}
                    {% if searchNom != '' or searchResp != '' %}
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap"
                             style="font-size:0.75rem; color:#6b6b6b;">
                            <i class="mdi mdi-filter-outline"></i>
                            Filtres actifs :
                            {% if searchNom != '' %}
                                <span class="filter-badge">
                                    <i class="mdi mdi-shield-outline"></i> {{ searchNom }}
                                </span>
                            {% endif %}
                            {% if searchResp != '' %}
                                <span class="filter-badge">
                                    <i class="mdi mdi-account-outline"></i> {{ searchResp }}
                                </span>
                            {% endif %}
                            <span style="color:#aaa;">— {{ clubs.getTotalItemCount }} résultat(s)</span>
                        </div>
                    {% endif %}

                </form>

                {# ── Tableau ── #}
                <div class="table-responsive">
                    <table class="table table-hover" id="clubsTable">
                        <thead style="background:#fafafa;">
                            <tr>
                                <th>Logo</th>
                                <th>Nom</th>
                                <th>Description</th>
                                <th>Date Création</th>
                                <th>Responsable</th>
                                <th style="width:120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for club in clubs %}
                        <tr>
                            <td>
                                {% if club.logo %}
                                    <img src="{{ vich_uploader_asset(club, 'logoFile') }}"
                                         alt="{{ club.nom }}"
                                         class="club-logo">
                                {% else %}
                                    <div class="no-logo">
                                        {{ club.nom|slice(0,2)|upper }}
                                    </div>
                                {% endif %}
                            </td>

                            <td><span class="fw-semibold">{{ club.nom }}</span></td>

                            <td class="text-muted small">
                                {{ club.description|u.truncate(80, '…') }}
                            </td>

                            <td class="text-muted small">
                                {{ club.dateCreation ? club.dateCreation|date('d/m/Y') : '—' }}
                            </td>

                            <td>
                                {% if club.responsable %}
                                    <span class="fw-semibold small">
                                        {{ club.responsable.prenom }} {{ club.responsable.nom }}
                                    </span>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>

                            <td>
                                <a href="{{ path('admin_club_show', {'id': club.id}) }}"
                                   class="btn btn-sm btn-outline-primary me-1" title="Détails">
                                    <i class="mdi mdi-eye"></i>
                                </a>

                                <form method="post"
                                      action="{{ path('admin_club_delete', {'id': club.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Supprimer ce club ?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ club.id) }}">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Supprimer">
                                        <i class="mdi mdi-trash-can-outline"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="mdi mdi-shield-off" style="font-size:2rem;opacity:0.3;"></i>
                                <p class="mt-2 mb-0">
                                    {% if searchNom != '' or searchResp != '' %}
                                        Aucun club ne correspond à votre recherche.
                                    {% else %}
                                        Aucun club trouvé.
                                    {% endif %}
                                </p>
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# ── Pagination ── #}
                <div class="d-flex justify-content-center mt-3">
                    {{ knp_pagination_render(clubs) }}
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}