{% extends 'backoffice/base.html.twig' %}
{% block title %}Club | Admin{% endblock %}

{% block stylesheets %}
<style>
.club-logo-big {
    width: 120px; height: 120px;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid #eee;
    background: #fafafa;
    padding: 8px;
}
.no-logo-big {
    width: 120px; height: 120px;
    border-radius: 12px;
    background: linear-gradient(135deg, #c10609, #8b0507);
    color: #fff; font-weight: 800; font-size: 2rem;
    display: flex; align-items: center; justify-content: center;
}
.info-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #c10609;
    margin-bottom: 4px;
}
.info-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0d0d0d;
}
.info-card {
    background: #fafafa;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.07);
    padding: 16px 20px;
}
</style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card" style="border-radius:12px; border-top:3px solid #c10609;">
            <div class="card-body">

                {# Header #}
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <h4 class="card-title mb-0">
                        <i class="mdi mdi-shield-star me-2" style="color:#c10609;"></i>
                        Instrument Sanss du Club
                    </h4>
                    <a href="{{ path('admin_club_index') }}"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="mdi mdi-arrow-left me-1"></i> Retour à la liste
                    </a>
                </div>

                <div class="row g-4">

                    {# Logo #}
                    <div class="col-12 col-md-2 text-center">
                        {% if club.logo %}
                            <img src="{{ vich_uploader_asset(club, 'logoFile') }}"
                                 alt="Logo {{ club.nom }}"
                                 class="club-logo-big">
                        {% else %}
                            <div class="no-logo-big mx-auto">
                                {{ club.nom|slice(0,2)|upper }}
                            </div>
                        {% endif %}
                    </div>

                    {# Infos #}
                    <div class="col-12 col-md-10">
                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <div class="info-card">
                                    <div class="info-label">Nom</div>
                                    <div class="info-value">{{ club.nom }}</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="info-card">
                                    <div class="info-label">Date de création</div>
                                    <div class="info-value">
                                        {{ club.dateCreation ? club.dateCreation|date('d/m/Y') : '—' }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="info-card">
                                    <div class="info-label">Description</div>
                                    <div class="info-value text-muted" style="font-weight:400;">
                                        {{ club.description ?: '—' }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="info-card">
                                    <div class="info-label">Site Web</div>
                                    <div class="info-value">
                                        {% if club.siteWeb %}
                                            <a href="{{ club.siteWeb }}" target="_blank" rel="noopener">
                                                <i class="mdi mdi-web me-1"></i>{{ club.siteWeb }}
                                            </a>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="info-card">
                                    <div class="info-label">Responsable</div>
                                    <div class="info-value">
                                        {% if club.responsable %}
                                            <i class="mdi mdi-account me-1" style="color:#c10609;"></i>
                                            {{ club.responsable.prenom }} {{ club.responsable.nom }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}
