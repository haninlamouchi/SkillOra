{% extends 'frontoffice/base.html.twig' %}
{% block title %}Paiement annulé | SkillOra{% endblock %}

{% block body %}
<section class="py-5" style="min-height:70vh;display:flex;align-items:center;">
    <div class="container">
        <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:20px;border:1px solid #e5e7eb;padding:40px 32px;box-shadow:0 4px 24px rgba(0,0,0,.07);text-align:center;">
            <div style="font-size:3.5rem;margin-bottom:8px;">❌</div>
            <h2 class="fw-bold mb-1" style="color:#dc2626;">Paiement annulé</h2>
            {% if userName is defined and userName %}
                <p class="text-muted mb-3">Bonjour <strong>{{ userName }}</strong>, votre tentative de paiement a été annulée.</p>
            {% else %}
                <p class="text-muted mb-3">Votre tentative de paiement a été annulée.</p>
            {% endif %}

            <div style="background:#fef2f2;border:2px solid #dc2626;border-radius:12px;padding:16px 20px;margin-bottom:24px;text-align:left;">
                <table class="w-100" style="font-size:.9rem;color:#374151;">
                    {% if formationName is defined and formationName %}
                    <tr>
                        <td class="py-1">Formation</td>
                        <td class="py-1 text-end fw-bold">{{ formationName }}</td>
                    </tr>
                    {% endif %}
                    <tr>
                        <td class="py-1">Statut</td>
                        <td class="py-1 text-end fw-bold" style="color:#dc2626;">Annulé ✗</td>
                    </tr>
                    <tr>
                        <td class="py-1 pt-2" style="font-size:.8rem;color:#6b7280;" colspan="2">Aucun montant n'a été débité.</td>
                    </tr>
                </table>
            </div>

            <p class="text-muted" style="font-size:.82rem;">Un email de notification a été envoyé à votre adresse.</p>
            <a href="{{ path('front_formation_index') }}" class="btn btn-outline-secondary mt-2">
                <i class="fa fa-arrow-left me-2"></i>Retour aux formations
            </a>
        </div>
    </div>
</section>
{% endblock %}
