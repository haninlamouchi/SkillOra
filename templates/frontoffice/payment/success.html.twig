{% extends 'frontoffice/base.html.twig' %}
{% block title %}Paiement réussi | SkillOra{% endblock %}

{% block body %}
<section class="py-5" style="min-height:70vh;display:flex;align-items:center;">
    <div class="container">
        <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:20px;border:1px solid #e5e7eb;padding:40px 32px;box-shadow:0 4px 24px rgba(0,0,0,.07);text-align:center;">
            <div style="font-size:3.5rem;margin-bottom:8px;">✅</div>
            <h2 class="fw-bold mb-1" style="color:#16a34a;">Paiement confirmé !</h2>
            {% if userName is defined and userName %}
                <p class="text-muted mb-3">Bonjour <strong>{{ userName }}</strong>, votre paiement a bien été traité.</p>
            {% else %}
                <p class="text-muted mb-3">Votre paiement a bien été traité.</p>
            {% endif %}

            <div style="background:#f0fdf4;border:2px solid #16a34a;border-radius:12px;padding:16px 20px;margin-bottom:24px;text-align:left;">
                <table class="w-100" style="font-size:.9rem;color:#374151;">
                    {% if formationName is defined and formationName %}
                    <tr>
                        <td class="py-1">Formation</td>
                        <td class="py-1 text-end fw-bold">{{ formationName }}</td>
                    </tr>
                    {% endif %}
                    {% if amountEur is defined and amountEur != '0,00' %}
                    <tr>
                        <td class="py-1">Montant payé</td>
                        <td class="py-1 text-end fw-bold">{{ amountEur }} €</td>
                    </tr>
                    {% endif %}
                    <tr>
                        <td class="py-1">Statut</td>
                        <td class="py-1 text-end fw-bold" style="color:#16a34a;">Payé ✓</td>
                    </tr>
                </table>
            </div>

            <p class="text-muted" style="font-size:.82rem;">Un email de confirmation a été envoyé à votre adresse.</p>
            <a href="{{ path('front_formation_index') }}" class="btn btn-success mt-2">
                <i class="fa fa-arrow-left me-2"></i>Retour aux formations
            </a>
        </div>
    </div>
</section>
{% endblock %}
