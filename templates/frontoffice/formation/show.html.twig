<script>
/* ── Google Charts: Ma Progression ── */
(function () {
    const raw = document.getElementById('prog-data');
    if (!raw) return;

    const data = JSON.parse(raw.textContent);

    google.charts.load('current', { packages: ['corechart'] });
    google.charts.setOnLoadCallback(function () {

        /* Donut */
        const donutEl = document.getElementById('prog-donut');
        if (donutEl) {
            const dt = google.visualization.arrayToDataTable(data.donut);
            new google.visualization.PieChart(donutEl).draw(dt, {
                pieHole: 0.48,
                legend: { position: 'bottom', textStyle: { fontSize: 11 } },
                colors: ['#15803d', '#f59e0b', '#9ca3af', '#6b7280'],
                chartArea: { width: '90%', height: '72%' },
                tooltip: { showColorCode: true },
                backgroundColor: 'transparent',
            });
        }

        /* Bar */
        const barEl = document.getElementById('prog-bar');
        if (barEl && data.bar.length > 1) {
            const dt = google.visualization.arrayToDataTable(data.bar);
            new google.visualization.ColumnChart(barEl).draw(dt, {
                legend: { position: 'none' },
                vAxis: { minValue: 0, maxValue: 100, gridlines: { count: 5 },
