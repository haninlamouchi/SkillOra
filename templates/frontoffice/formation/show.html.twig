{% block javascripts %}{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.filter-btn[data-section]');
    const sectionIds = { videos: 'section-videos', quiz: 'section-quiz', Progress: 'section-Progress', evaluer: 'section-evaluer' };

    tabs.forEach(btn => {
        btn.addEventListener('click', function () {
            tabs.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const target = this.dataset.section;
            Object.entries(sectionIds).forEach(([key, id]) => {
                const el = document.getElementById(id);
                if (el) el.style.display = (key === target) ? '' : 'none';
            });
        });
    });

    /* ── Flashcard logic ── */
    const rawData = document.getElementById('fcData');
    if (!rawData) return;
    let CARDS = JSON.parse(rawData.textContent || '[]');
    if (!CARDS.length) return;

    const overlay    = document.getElementById('fcOverlay');
    const card       = document.getElementById('fcCard');
    const qEl        = document.getElementById('fcQuestion');
    const aEl        = document.getElementById('fcAnswer');
    const counter    = document.getElementById('fcCounter');
    const progressFill = document.getElementById('fcProgressFill');
    const btnPrev    = document.getElementById('fcPrev');
    const btnNext    = document.getElementById('fcNext');
    const btnClose   = document.getElementById('fcClose');
    const btnShuffle = document.getElementById('fcShuffle');
    const btnOpen    = document.getElementById('btnOpenFlashcards');

    let idx = 0;

    function shuffle(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
    }

    function render() {
        const c = CARDS[idx];
        qEl.textContent = c.q;
        aEl.textContent = c.a;
        card.classList.remove('flipped');
        counter.textContent = (idx + 1) + ' / ' + CARDS.length;
        progressFill.style.width = ((idx + 1) / CARDS.length * 100) + '%';
        btnPrev.disabled = idx === 0;
        btnNext.disabled = idx === CARDS.length - 1;
    }

    function open() {
        idx = 0; render();
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function close() {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
    }

    if (btnOpen) btnOpen.addEventListener('click', open);
    btnClose.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });

    card.addEventListener('click', function () { card.classList.toggle('flipped'); });
    btnPrev.addEventListener('click', function () { if (idx > 0) { idx--; render(); } });
    btnNext.addEventListener('click', function () { if (idx < CARDS.length - 1) { idx++; render(); } });
    btnShuffle.addEventListener('click', function () {
        shuffle(CARDS); idx = 0; render();
        btnShuffle.textContent = '✓ Mélangé !';
        setTimeout(function () { btnShuffle.innerHTML = '<i class="fa fa-random"></i> Mélanger'; }, 1200);
    });

    document.addEventListener('keydown', function (e) {
        if (!overlay.classList.contains('open')) return;
        if (e.key === 'ArrowLeft'  && idx > 0)               { idx--; render(); }
        if (e.key === 'ArrowRight' && idx < CARDS.length - 1) { idx++; render(); }
        if (e.key === ' ' || e.key === 'Enter')  { card.classList.toggle('flipped'); e.preventDefault(); }
        if (e.key === 'Escape') close();
    });
});
</script>
