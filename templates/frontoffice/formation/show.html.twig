<script>
(function () {
    /* ── Chatbot ── */
    const CHAT_URL = {{ path('front_formation_chatbot', {id: formation.id})|json_encode|raw }};
    const bubble   = document.getElementById('cb-bubble');
    const win      = document.getElementById('cb-window');
    const msgs     = document.getElementById('cb-messages');
    const input    = document.getElementById('cb-input');
    const sendBtn  = document.getElementById('cb-send');
    const closeBtn = document.getElementById('cb-close-btn');
    const clearBtn = document.getElementById('cb-clear');
    const badge    = document.getElementById('cb-badge');

    let isOpen    = false;
    let isBusy    = false;
    let unreadCnt = 0;

    /* ── helpers ── */
    function scrollBottom() {
        msgs.scrollTop = msgs.scrollHeight;
    }

    function appendMsg(text, role) {
        const d = document.createElement('div');
        d.className = 'cb-msg cb-msg-' + role;
        d.innerHTML = text.replace(/\n/g, '<br>');
        msgs.appendChild(d);
        scrollBottom();
        return d;
    }

    function showTyping() {
        const t = document.createElement('div');
        t.className = 'cb-typing'; t.id = 'cb-typing';
        t.innerHTML = '<div class="cb-dot"></div><div class="cb-dot"></div><div class="cb-dot"></div>';
        msgs.appendChild(t);
        scrollBottom();
    }

    function hideTyping() {
        const t = document.getElementById('cb-typing');
        if (t) t.remove();
    }

    function setBusy(state) {
        isBusy = state;
        sendBtn.disabled = state;
        input.disabled   = state;
    }

    /* ── open / close ── */
    function openChat() {
        isOpen = true;
        win.classList.add('open');
        bubble.style.transform = 'scale(0.92)';
        unreadCnt = 0;
        badge.style.display = 'none';
        input.focus();
        scrollBottom();
    }

    function closeChat() {
        isOpen = false;
        win.classList.remove('open');
        bubble.style.transform = '';
    }

    bubble.addEventListener('click', function () { isOpen ? closeChat() : openChat(); });
    closeBtn.addEventListener('click', closeChat);

    clearBtn.addEventListener('click', function () {
        msgs.innerHTML = '';
        appendMsg('Conversation effacée. Comment puis-je vous aider ?', 'bot');
    });

    /* ── auto-grow textarea ── */
    input.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 100) + 'px';
    });

    /* ── send on Enter (Shift+Enter = newline) ── */
    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });
    sendBtn.addEventListener('click', sendMessage);

    /* ── send ── */
    function sendMessage() {
        const text = input.value.trim();
        if (!text || isBusy) return;

        appendMsg(text, 'user');
        input.value = '';
        input.style.height = 'auto';
        setBusy(true);
        showTyping();

        fetch(CHAT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            hideTyping();
            if (data.error) {
                appendMsg('❌ ' + data.error, 'bot');
            } else {
                appendMsg(data.reply, 'bot');
                if (!isOpen) {
                    unreadCnt++;
                    badge.textContent = unreadCnt;
                    badge.style.display = 'flex';
                }
            }
        })
        .catch(function () {
            hideTyping();
            appendMsg('❌ Une erreur réseau est survenue. Veuillez réessayer.', 'bot');
        })
        .finally(function () { setBusy(false); });
    }
})();
</script>
{% endblock %}
