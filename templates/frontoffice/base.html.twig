<!-- FLASH MESSAGES -->
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="sk-flash sk-flash--{{ type }}">
            <span class="sk-flash-icon">
                {% if type == 'success' %}✅{% elseif type == 'error' %}❌{% elseif type == 'warning' %}⚠️{% else %}ℹ️{% endif %}
            </span>
            <span class="sk-flash-msg">{{ message }}</span>
            <button class="sk-flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
    {% endfor %}
{% endfor %}

<style>
.sk-flash {
    position: fixed; top: 82px; right: 24px; z-index: 9999;
    display: flex; align-items: center; gap: 10px;
    padding: 14px 18px; border-radius: 12px;
    font-size: 0.88rem; font-weight: 600;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    max-width: 420px; animation: flashIn 0.35s ease;
}
@keyframes flashIn {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
}
.sk-flash--success { background: #f0fdf4; color: #15803d; border-left: 4px solid #22c55e; }
.sk-flash--error   { background: #fef2f2; color: #b91c1c; border-left: 4px solid #ef4444; }
.sk-flash--warning { background: #fffbeb; color: #92400e; border-left: 4px solid #f59e0b; }
.sk-flash--info    { background: #eff6ff; color: #1d4ed8; border-left: 4px solid #3b82f6; }
.sk-flash-icon { font-size: 1rem; flex-shrink: 0; }
.sk-flash-msg  { flex: 1; }
.sk-flash-close {
    background: none; border: none; font-size: 1.2rem;
    cursor: pointer; color: inherit; opacity: 0.5;
    padding: 0; line-height: 1; flex-shrink: 0;
}
.sk-flash-close:hover { opacity: 1; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.sk-flash').forEach(function(el, i) {
        el.style.top = (82 + i * 70) + 'px';
        setTimeout(function() {
            el.style.transition = 'opacity 0.4s, transform 0.4s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(40px)';
            setTimeout(function() { el.remove(); }, 400);
        }, 4000);
    });
});
</script>

