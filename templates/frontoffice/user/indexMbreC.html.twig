{% extends 'frontoffice/base.html.twig' %}
{% block title %}Clubs — SkillOra{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@700;900&display=swap');

:root {
    --red:      #c10609;
    --red-mid:  #8b0507;
    --red-soft: rgba(193,6,9,0.07);
    --ink:      #0d0d0d;
    --muted:    #6b6b6b;
    --border:   rgba(0,0,0,0.08);
    --bg:       #f2f2f2;
    --white:    #ffffff;
    --radius:   18px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); font-family: 'DM Sans', sans-serif; color: var(--ink); }

.clubs-shell {
    min-height: 100vh;
    padding: 100px 0 80px;
}
.clubs-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
}

.page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
    flex-wrap: wrap;
    animation: fadeUp 0.5s ease both;
}
.page-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.page-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px; height: 2px;
    background: var(--red);
}
.page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.1;
}
.page-title em { font-style: normal; color: var(--red); }
.page-sub {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 8px;
    font-weight: 400;
}

.btn-creer {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--ink);
    color: #fff;
    padding: 13px 26px;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    border: 2px solid var(--ink);
    white-space: nowrap;
}
.btn-creer:hover {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(193,6,9,0.28);
}
.btn-creer-ico {
    width: 22px; height: 22px;
    background: rgba(255,255,255,0.15);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem;
}

.flash-zone { margin-bottom: 24px; }
.flash-msg {
    padding: 13px 18px;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 8px;
}
.flash-success { background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; }
.flash-warning { background: #fffbeb; border-left: 4px solid #f59e0b; color: #92400e; }
.flash-danger  { background: #fef2f2; border-left: 4px solid var(--red); color: #7f1d1d; }

.clubs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    animation: fadeUp 0.5s 0.1s ease both;
}

.club-card {
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.club-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.10);
    border-color: rgba(193,6,9,0.25);
}
.club-card-img {
    height: 130px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    display: flex; align-items: center; justify-content: center;
    font-size: 3rem;
    position: relative;
    overflow: hidden;
}
.club-card-img::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.4));
}
.club-card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; inset: 0;
}
.club-card-img-emoji {
    position: relative; z-index: 1;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));
}
.club-card::before {
    content: '';
    display: block;
    height: 3px;
    background: var(--red);
    flex-shrink: 0;
}
.club-card-body {
    padding: 20px 22px 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.club-card-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.club-card-desc {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.club-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
}
.club-meta-tag {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted);
    display: flex; align-items: center; gap: 4px;
}
.club-meta-tag i { color: var(--red); font-size: 0.65rem; }
.club-card-footer {
    padding: 0 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.club-card-sep {
    height: 1px;
    background: var(--border);
    margin-bottom: 4px;
}
.btn-rejoindre {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 11px;
    background: var(--red);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.3px;
}
.btn-rejoindre:hover {
    background: var(--red-mid);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(193,6,9,0.3);
}
.btn-site {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    width: 100%; padding: 9px;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
}
.btn-site:hover {
    border-color: var(--ink);
    color: var(--ink);
    text-decoration: none;
}

.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 20px;
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid var(--border);
}
.empty-state-ico {
    font-size: 3.5rem;
    margin-bottom: 20px;
    display: block;
    opacity: 0.5;
}
.empty-state h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
}
.empty-state p { font-size: 0.875rem; color: var(--muted); }

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}
.club-card { animation: fadeUp 0.4s ease both; }
.club-card:nth-child(1) { animation-delay: 0.08s; }
.club-card:nth-child(2) { animation-delay: 0.14s; }
.club-card:nth-child(3) { animation-delay: 0.20s; }
.club-card:nth-child(4) { animation-delay: 0.26s; }
.club-card:nth-child(5) { animation-delay: 0.32s; }
.club-card:nth-child(6) { animation-delay: 0.38s; }

@media (max-width: 1024px) { .clubs-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) {
    .clubs-grid { grid-template-columns: 1fr; }
    .clubs-wrap { padding: 0 16px; }
    .page-header { flex-direction: column; align-items: flex-start; }
}

{# ✅ Style Pagination personnalisé #}
.pagination-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 40px;
    gap: 12px;
}
.pagination {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
}
.pagination li a,
.pagination li span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid var(--border);
    color: var(--ink);
    background: var(--white);
}
.pagination li a:hover {
    background: var(--red-soft);
    border-color: var(--red);
    color: var(--red);
}
.pagination li.active span {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    font-weight: 700;
}
.pagination li.disabled span {
    opacity: 0.4;
    cursor: not-allowed;
}
.pagination-info {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 500;
}
</style>
{% endblock %}

{% block body %}
<div class="clubs-shell">
<div class="clubs-wrap">

    {# ── Flash ── #}
    <div class="flash-zone">
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="flash-msg flash-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }}">
                    {{ type == 'success' ? '✅' : (type == 'warning' ? '⚠️' : '❌') }} {{ msg }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {# ── Header ── #}
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-eyebrow">Communauté</div>
            <h1 class="page-title">Nos <em>Clubs</em></h1>
            <p class="page-sub">Rejoignez un club et participez à la vie associative de SkillOra.</p>
        </div>
        <a href="{{ path('user_club_new') }}" class="btn-creer">
            <span class="btn-creer-ico">✦</span>
            Proposer un club
        </a>
    </div>

    {# ── Grid ── #}
    <div class="clubs-grid">
        {% for club in clubs %}
        <div class="club-card">

            <div class="club-card-img">
                {% if club.logo %}
                    <img src="{{ vich_uploader_asset(club, 'logoFile') }}" alt="{{ club.nom }}">
                {% else %}
                    <span class="club-card-img-emoji">🏛️</span>
                {% endif %}
            </div>

            <div class="club-card-body">
                <p class="club-card-name">{{ club.nom }}</p>
                {% if club.description %}
                    <p class="club-card-desc">{{ club.description }}</p>
                {% endif %}
                <div class="club-card-meta">
                    {% if club.dateCreation %}
                        <span class="club-meta-tag">
                            <i class="fas fa-calendar"></i>
                            {{ club.dateCreation|date('d/m/Y') }}
                        </span>
                    {% endif %}
                    {% if club.responsable %}
                        <span class="club-meta-tag">
                            <i class="fas fa-user-tie"></i>
                            {{ club.responsable.prenom }} {{ club.responsable.nom }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="club-card-footer">
                <div class="club-card-sep"></div>
                <form method="post" action="{{ path('user_club_adhesion', {'id': club.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('adhesion' ~ club.id) }}">
                    <button type="submit" class="btn-rejoindre">
                        <i class="fas fa-plus-circle"></i> Devenir membre
                    </button>
                </form>
                {% if club.siteWeb %}
                    <a href="{{ club.siteWeb }}" target="_blank" rel="noopener" class="btn-site">
                        <i class="fas fa-globe"></i> Voir le site
                    </a>
                {% endif %}
            </div>

        </div>
        {% else %}
        <div class="empty-state">
            <span class="empty-state-ico">🏛️</span>
            <h3>Aucun club disponible</h3>
            <p>Soyez le premier à proposer un club à la communauté SkillOra.</p>
        </div>
        {% endfor %}
    </div>

    {# ✅ Pagination #}
    <div class="pagination-wrapper">
        {{ knp_pagination_render(clubs) }}
        <p class="pagination-info">
            Page {{ clubs.currentPageNumber }} sur {{ clubs.pageCount }}
            — {{ clubs.totalItemCount }} clubs au total
        </p>
    </div>

</div>
</div>
{% endblock %}