          {% set totalQR = quizResults|length %}
          {% set pageCountQR = totalQR > 0 ? ((totalQR - 1) // 5 + 1) : 0 %}
          <div class="sk-card-head"><span class="sk-card-head-title">🏆 Résultats des Quiz ({{ totalQR }})</span></div>
          {% if totalQR > 0 %}
            <div class="sk-table-wrap">
              <table class="sk-table">
                <thead>
                  <tr>
                    <th>#</th><th>Participant</th><th>Quiz</th>
                    <th style="text-align:center">Score</th><th style="text-align:center">Résultat</th>
                    <th style="text-align:right">Date</th>
