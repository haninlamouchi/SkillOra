      {# ══════════════════════════════════════════════════════
         📊 CHARTS SECTION — Google Charts (3 visualisations)
         ══════════════════════════════════════════════════════ #}
      <div class="content-section d-none" id="charts">

        {# Build JS arrays from Twig data #}
        {% set studentRows = [] %}
        {% set passCount   = 0 %}
        {% set failCount   = 0 %}
        {% set noQuiz      = 0 %}
        {% set buckets     = [0,0,0,0,0] %}{# 0-20,20-40,40-60,60-80,80-100 #}

        {% for participation in formation.participations %}
          {% set uid  = participation.user.id %}
          {% set name = participation.user.fullName %}
          {% if participantScores[uid] is defined %}
            {% set pct = participantScores[uid].pct %}
            {% set studentRows = studentRows|merge([{'name': name, 'pct': pct}]) %}
            {% if pct >= 50 %}{% set passCount = passCount + 1 %}
            {% else %}{% set failCount = failCount + 1 %}{% endif %}
            {% if pct <= 20 %}{% set buckets = [buckets[0]+1, buckets[1], buckets[2], buckets[3], buckets[4]] %}
            {% elseif pct <= 40 %}{% set buckets = [buckets[0], buckets[1]+1, buckets[2], buckets[3], buckets[4]] %}
            {% elseif pct <= 60 %}{% set buckets = [buckets[0], buckets[1], buckets[2]+1, buckets[3], buckets[4]] %}
            {% elseif pct <= 80 %}{% set buckets = [buckets[0], buckets[1], buckets[2], buckets[3]+1, buckets[4]] %}
            {% else %}{% set buckets = [buckets[0], buckets[1], buckets[2], buckets[3], buckets[4]+1] %}{% endif %}
          {% else %}
            {% set noQuiz = noQuiz + 1 %}
          {% endif %}
        {% endfor %}

        <div id="gcharts-bar"   style="width:100%;height:320px;" class="sk-card" style="padding:20px;"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
          <div id="gcharts-pie" class="sk-card" style="width:100%;height:300px;"></div>
          <div id="gcharts-col" class="sk-card" style="width:100%;height:300px;"></div>
        </div>

        <script>
        // ── Google Charts data from Twig ──────────────────────
        const studentData  = {{ studentRows|json_encode|raw }};
        const passCount    = {{ passCount }};
        const failCount    = {{ failCount }};
        const noQuizCount  = {{ noQuiz }};
        const bucketCounts = {{ buckets|json_encode|raw }};

        google.charts.setOnLoadCallback(drawAllCharts);

        function drawAllCharts() {
          drawBar();
          drawPie();
          drawCol();
        }

        // ── 1. Bar chart: score per student ───────────────────
        function drawBar() {
          const data = new google.visualization.DataTable();
          data.addColumn('string', 'Étudiant');
          data.addColumn('number', 'Score %');
          data.addColumn({type:'string', role:'style'});
          data.addColumn({type:'string', role:'annotation'});

          if (studentData.length === 0) {
            data.addRows([['Aucune donnée', 0, 'color:#e5e7eb', '']]);
          } else {
            studentData.forEach(s => {
              const clr = s.pct >= 70 ? '#16a34a' : s.pct >= 50 ? '#d97706' : '#dc2626';
              data.addRow([s.name, s.pct, 'color:' + clr, s.pct + '%']);
            });
          }

          const options = {
            title: '📊 Performance par étudiant',
            titleTextStyle: { fontName:'DM Sans', fontSize:15, bold:true, color:'#180808' },
            hAxis: { title:'Score (%)', minValue:0, maxValue:100, format:"#'%'", textStyle:{fontName:'DM Sans'} },
            vAxis: { textStyle:{fontName:'DM Sans',fontSize:12} },
            legend: 'none',
            bars: 'horizontal',
            bar: { groupWidth:'60%' },
            chartArea: { left:140, top:50, width:'75%', height:'80%' },
            backgroundColor: 'transparent',
            fontName: 'DM Sans',
          };
          const chart = new google.visualization.BarChart(document.getElementById('gcharts-bar'));
          chart.draw(data, options);
        }

        // ── 2. Donut chart: pass / fail / no attempt ──────────
        function drawPie() {
          const data = google.visualization.arrayToDataTable([
            ['Statut', 'Étudiants'],
            ['Réussi (≥50%)',   passCount],
            ['Échoué (<50%)',   failCount],
            ['Sans quiz',       noQuizCount],
          ]);
          const options = {
            title: '🥇 Taux de réussite',
            titleTextStyle: { fontName:'DM Sans', fontSize:14, bold:true, color:'#180808' },
            pieHole: 0.42,
            colors: ['#16a34a','#dc2626','#9ca3af'],
            legend: { position:'bottom', textStyle:{fontName:'DM Sans',fontSize:12} },
            chartArea: { top:44, width:'90%', height:'72%' },
            backgroundColor: 'transparent',
            fontName: 'DM Sans',
          };
          const chart = new google.visualization.PieChart(document.getElementById('gcharts-pie'));
          chart.draw(data, options);
        }

        // ── 3. Column chart: score distribution buckets ───────
        function drawCol() {
          const data = google.visualization.arrayToDataTable([
            ['Tranche', 'Étudiants', {role:'style'}, {role:'annotation'}],
            ['0–20 %',  bucketCounts[0], 'color:#dc2626', bucketCounts[0]||''],
            ['20–40 %', bucketCounts[1], 'color:#f97316', bucketCounts[1]||''],
            ['40–60 %', bucketCounts[2], 'color:#d97706', bucketCounts[2]||''],
            ['60–80 %', bucketCounts[3], 'color:#22c55e', bucketCounts[3]||''],
            ['80–100%', bucketCounts[4], 'color:#16a34a', bucketCounts[4]||''],
          ]);
          const options = {
            title: '📈 Distribution des scores',
            titleTextStyle: { fontName:'DM Sans', fontSize:14, bold:true, color:'#180808' },
            hAxis: { textStyle:{fontName:'DM Sans',fontSize:12} },
            vAxis: { title:'Nb étudiants', format:'#', minValue:0, textStyle:{fontName:'DM Sans'} },
            legend: 'none',
            bar: { groupWidth:'55%' },
            chartArea: { left:50, top:44, width:'85%', height:'72%' },
            backgroundColor: 'transparent',
            fontName: 'DM Sans',
          };
          const chart = new google.visualization.ColumnChart(document.getElementById('gcharts-col'));
          chart.draw(data, options);
        }

        // Redraw on tab activation
        document.querySelector('[data-section="charts"]')?.addEventListener('click', () => {
          setTimeout(drawAllCharts, 60);
        });
        </script>
      </div>

      <!-- Participants -->
      <div class="content-section d-none" id="participants">
        <!-- Participants -->
        <div class="sk-card">
          <div class="sk-card-head">
            <span class="sk-card-head-title">👥 Participants ({{ formation.participations|length }})</span>
            <button type="button" class="sk-btn sk-btn-blue sk-btn-sm" onclick="document.getElementById('modalParticipant').classList.add('open')">➕ Ajouter un participant</button>
          </div>
          {% if formation.participations|length > 0 %}
            <div class="sk-table-wrap">
              <table class="sk-table">
                <thead>
                  <tr>
                    <th>#</th><th>Participant</th><th>Email</th><th>Rôle</th>
                    <th style="text-align:center">Score Quiz</th><th>Date</th>
                    <th style="text-align:right">Action</th>
                  </tr>
                </thead>
                <tbody>
                  {% for participation in formation.participations %}
                    {% set uid = participation.user.id %}
                    <tr>
                      <td style="color:var(--sk-muted)">{{ loop.index }}</td>
                      <td>
                        <div style="display:flex;align-items:center;gap:10px">
                          <div class="sk-avatar">
                            {% if participation.user.photo %}<img src="{{ participation.user.photo }}" alt="">
                            {% else %}{{ participation.user.fullName|first|upper }}{% endif %}
                          </div>
                          <span style="font-weight:700">{{ participation.user.fullName }}</span>
                        </div>
                      </td>
                      <td style="color:var(--sk-muted)">{{ participation.user.email }}</td>
                      <td>
                        {% set role = participation.user.role %}
                        <span class="sk-role {% if role=='admin' %}sk-role-admin{% elseif role=='responsable_club' %}sk-role-resp{% else %}sk-role-other{% endif %}">{{ role }}</span>
                      </td>
                      <td style="text-align:center">
                        {% if participantScores[uid] is defined %}
                          {% set s = participantScores[uid] %}
                          <span style="font-weight:700">{{ s.score }}/{{ s.totalPoints }}</span>
                          <span class="sk-score-badge {% if s.pct >= 70 %}sk-score-good{% elseif s.pct >= 50 %}sk-score-mid{% else %}sk-score-bad{% endif %}">{{ s.pct }}%</span>
                          <div style="font-size:0.70rem;color:var(--sk-muted);margin-top:2px">{{ s.quizTitre }}</div>
                        {% else %}<span style="color:var(--sk-muted)">—</span>{% endif %}
                      </td>
                      <td style="color:var(--sk-muted)">{{ participation.dateParticipation|date('d/m/Y H:i') }}</td>
                      <td style="text-align:right">
                        <form action="{{ path('app_formation_remove_participant', {id: formation.id, participationId: participation.id}) }}" method="post" style="margin:0" onsubmit="return confirm('Retirer ce participant ?')">
                          <input type="hidden" name="_token" value="{{ csrf_token('remove_participant' ~ participation.id) }}">
                          <button type="submit" class="sk-btn sk-btn-danger sk-btn-sm">❌ Retirer</button>
                        </form>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="sk-empty-inline"><div class="icon">👥</div><p>Aucun participant inscrit.</p></div>
          {% endif %}
        </div>
      </div>     

    </div>
  </div>
</div>

<!-- MODAL: Add Video -->
