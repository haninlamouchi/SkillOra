                      <a href="{{ path('app_level_quiz_new', {formationId: formation.id, id: level.id}) }}" class="sk-btn sk-btn-primary sk-btn-sm">➕ Quiz</a>
                      <a href="{{ path('app_level_edit', {formationId: formation.id, id: level.id}) }}" class="sk-btn sk-btn-warn sk-btn-sm">✏️</a>
                      <form action="{{ path('app_level_delete', {formationId: formation.id, id: level.id}) }}" method="post" style="margin:0" onsubmit="return confirm('Supprimer ce niveau et tous ses quiz ?')">
