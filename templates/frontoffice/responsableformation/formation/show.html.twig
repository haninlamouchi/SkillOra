<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const sections = document.querySelectorAll('.content-section');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const target = button.dataset.section;

      buttons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      sections.forEach(section => {
        section.classList.add('d-none');
      });

      const targetSection = document.getElementById(target);
      if (targetSection) {
        targetSection.classList.remove('d-none');
      }
    });
  });
</script>
<script>
  // Close modals on overlay click
  document.querySelectorAll('.sk-modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });
  });
</script>
<script>
  const addCardBtn = document.getElementById('add-card-btn');
  const cardModal = document.getElementById('card-modal');
  const closeCardBtn = document.getElementById('close-card-modal');
  const cancelCardBtn = document.getElementById('cancel-card-modal');
  const cardForm = document.getElementById('card-form');
  const cardModalTitle = document.getElementById('card-modal-title');
  const cardTokenInput = document.getElementById('card-token');
  const questionInput = document.getElementById('question-input');
  const answerInput = document.getElementById('answer-input');
  const editCardButtons = document.querySelectorAll('.edit-card-btn');

  const addAction = '{{ path('app_flashcard_add', {id: formation.id}) }}';
  const addToken = '{{ csrf_token('add_flashcard_' ~ formation.id) }}';

  function openCardModal() {
    cardModal?.classList.add('open');
    questionInput?.focus();
  }

  function closeCardModal() {
    cardModal?.classList.remove('open');
  }

  addCardBtn?.addEventListener('click', () => {
    if (!cardForm) {
      return;
    }
    cardModalTitle.textContent = '🧠 Ajouter une carte';
    cardForm.action = addAction;
    cardTokenInput.value = addToken;
    questionInput.value = '';
    answerInput.value = '';
    openCardModal();
  });

  editCardButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!cardForm) {
        return;
      }
      const question = btn.dataset.question || '';
      const answer = btn.dataset.answer || '';
      const editAction = btn.dataset.action || addAction;
      const editToken = btn.dataset.token || addToken;

      cardModalTitle.textContent = '✏️ Modifier la carte';
      cardForm.action = editAction;
      cardTokenInput.value = editToken;
      questionInput.value = question;
      answerInput.value = answer;
      openCardModal();
    });
  });

  closeCardBtn?.addEventListener('click', closeCardModal);
  cancelCardBtn?.addEventListener('click', closeCardModal);
</script>
<script>
(function () {
  var PER_PAGE = 5;
  var rows = Array.from(document.querySelectorAll('#quiz-table-body .qr-row'));
  if (!rows.length) return;
  var total = rows.length;
  var pageCount = Math.ceil(total / PER_PAGE);
  var cur = 1;

  function showPage(p) {
    cur = p;
    var s = (p - 1) * PER_PAGE;
    var e = s + PER_PAGE;
    rows.forEach(function (tr, i) {
      tr.style.display = (i >= s && i < e) ? '' : 'none';
      if (i >= s && i < e) tr.querySelector('.qr-row-num').textContent = i + 1;
    });
    var info = document.getElementById('qr-info');
    if (info) info.innerHTML = 'Affichage <strong>' + (s + 1) + '\u2013' + Math.min(e, total) + '</strong> sur <strong>' + total + '</strong> résultats';
    var prev = document.getElementById('qr-prev');
    var next = document.getElementById('qr-next');
    if (prev) prev.classList.toggle('sk-pag-disabled', p <= 1);
    if (next) next.classList.toggle('sk-pag-disabled', p >= pageCount);
    document.querySelectorAll('.qr-pag-num').forEach(function (a) {
      a.classList.toggle('sk-pag-active', +a.dataset.page === p);
    });
  }

  showPage(1);

  var prev = document.getElementById('qr-prev');
  var next = document.getElementById('qr-next');
  if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); if (cur > 1) showPage(cur - 1); });
  if (next) next.addEventListener('click', function (e) { e.preventDefault(); if (cur < pageCount) showPage(cur + 1); });
  document.querySelectorAll('.qr-pag-num').forEach(function (a) {
    a.addEventListener('click', function (e) { e.preventDefault(); showPage(+a.dataset.page); });
  });
})();
</script>

