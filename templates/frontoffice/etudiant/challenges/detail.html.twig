{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ challenge.titre }}{% endblock %}

{% block body %}
<div class="card">
    <a href="{{ path('app_etudiant_challenges') }}" style="color: #3498db; text-decoration: none; margin-bottom: 1rem; display: inline-block;">
        ← Retour aux challenges
    </a>

    <h2>{{ challenge.titre }}</h2>
    
    <div style="background: #ecf0f1; padding: 1rem; border-radius: 4px; margin: 1.5rem 0;">
        <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
            <div>
                <strong>📅 Date de début:</strong> {{ challenge.dateDebut|date('d/m/Y') }}
            </div>
            <div>
                <strong>📅 Date de fin:</strong> {{ challenge.dateFin|date('d/m/Y') }}
            </div>
        </div>
    </div>

    {% if challenge.image %}
        <div style="margin: 1.5rem 0;">
            <img src="{{ asset('uploads/' ~ challenge.image) }}" alt="{{ challenge.titre }}" 
                 style="max-width: 100%; border-radius: 8px;">
        </div>
    {% endif %}

    <div style="margin: 1.5rem 0;">
        <h3 style="color: #2c3e50; margin-bottom: 0.5rem;">📝 Description</h3>
        <p style="line-height: 1.6; color: #34495e;">{{ challenge.description }}</p>
    </div>

    {% if challenge.fichierCahierCharges %}
        <div style="background: #fff3cd; padding: 1rem; border-radius: 4px; margin: 1.5rem 0;">
            <strong>📄 Cahier des charges:</strong>
            <a href="{{ asset('uploads/' ~ challenge.fichierCahierCharges) }}" 
               target="_blank" 
               style="color: #856404; margin-left: 0.5rem;">
                Télécharger le PDF
            </a>
        </div>
    {% endif %}

    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 2px solid #ecf0f1;">
        <a href="{{ path('app_etudiant_challenge_participate', {id: challenge.id}) }}" class="btn btn-success" style="font-size: 1.1rem; padding: 1rem 2rem;">
            ✅ Participer à ce challenge
        </a>
    </div>
</div>
{% endblock %}