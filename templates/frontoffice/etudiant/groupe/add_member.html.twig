{% extends 'frontoffice/base.html.twig' %}

{% block title %}Ajouter un membre - {{ groupe.nomGroupe }}{% endblock %}

{% block body %}
<div class="card">
    <a href="{{ path('app_etudiant_groupe_show', {id: groupe.id}) }}" 
       style="color: #e53e3e; text-decoration: none; margin-bottom: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">
        ← Retour au groupe
    </a>

    <h2>➕ Ajouter un membre à "{{ groupe.nomGroupe }}"</h2>
    <p style="color: #718096; margin: 0.5rem 0 2rem 0;">Sélectionnez un utilisateur à ajouter</p>

    {% if availableUsers is empty %}
        <div class="empty-state">
            <div class="icon">😔</div>
            <p>Aucun utilisateur disponible</p>
            <p style="font-size: 0.9rem; margin-top: 0.5rem;">Tous les utilisateurs sont déjà dans le groupe</p>
        </div>
    {% else %}
        <form method="post">
            <div class="form-group">
                <label>Sélectionner un utilisateur</label>
                <select name="user_id" class="form-control" required>
                    <option value="">-- Choisir un étudiant --</option>
                    {% for user in availableUsers %}
                        <option value="{{ user.id }}">{{ user.nom }} {{ user.prenom }} ({{ user.email }})</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label>Rôle dans le groupe</label>
                <div style="display: flex; gap: 1rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="role" value="membre" checked>
                        <span>👤 Membre</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="role" value="chef">
                        <span>⭐ Chef de groupe</span>
                    </label>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 2px solid #e2e8f0;">
                <button type="submit" class="btn btn-success" style="padding: 1rem 2rem;">
                    ✅ Ajouter au groupe
                </button>
                <a href="{{ path('app_etudiant_groupe_show', {id: groupe.id}) }}" class="btn btn-secondary" style="padding: 1rem 2rem;">
                    ❌ Annuler
                </a>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}