{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mon Groupe{% endblock %}

{% block body %}
<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2>👥 Mon Groupe</h2>
        <a href="{{ path('app_etudiant_groupe_new') }}" class="btn btn-success">
            ➕ Créer un groupe
        </a>
    </div>

    {# BARRE DE RECHERCHE ET TRI #}
    <div style="background: #f7fafc; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
        <form method="get" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: end;">
            <div style="flex: 1; min-width: 250px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748;">
                    🔍 Rechercher
                </label>
                <input type="text" 
                       name="search" 
                       value="{{ search }}" 
                       placeholder="Nom du groupe..."
                       style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px;">
            </div>
            
            <div style="min-width: 120px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748;">
                    ↕️ Ordre
                </label>
                <select name="order" style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>A → Z</option>
                    <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Z → A</option>
                </select>
            </div>
            
            <div style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.5rem;">
                    Filtrer
                </button>
                <a href="{{ path('app_etudiant_groupe') }}" class="btn btn-secondary" style="padding: 0.75rem 1.5rem;">
                    Réinitialiser
                </a>
            </div>
        </form>
    </div>
    
    {% if search %}
        <p style="color: #718096; margin-bottom: 1rem;">
            📊 {{ groupes|length }} résultat(s) pour "{{ search }}"
        </p>
    {% endif %}

    {% if groupes is empty %}
        <div style="text-align: center; padding: 3rem; color: #7f8c8d;">
            <p style="font-size: 3rem;">👤</p>
            <p>Vous n'avez pas encore de groupe</p>
            <a href="{{ path('app_etudiant_groupe_new') }}" class="btn" style="margin-top: 1rem;">
                Créer votre premier groupe
            </a>
        </div>
    {% else %}
        <div style="display: grid; gap: 1.5rem;">
            {% for groupe in groupes %}
                <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem;">
                    <h3 style="color: #2c3e50; margin-bottom: 0.5rem;">{{ groupe.nomGroupe }}</h3>
                    
                    <div style="margin: 1rem 0;">
                        <strong>Membres:</strong>
                        <div style="margin-top: 0.5rem;">
                            {% for membre in groupe.membres %}
                                <span style="background: #ecf0f1; padding: 0.3rem 0.8rem; border-radius: 4px; margin-right: 0.5rem; display: inline-block; margin-bottom: 0.5rem;">
                                    👤 {{ membre.user.nom }} {{ membre.user.prenom }}
                                    {% if membre.role == 'chef' %}
                                        <span style="color: #e74c3c;">★ Chef</span>
                                    {% endif %}
                                </span>
                            {% endfor %}
                        </div>
                    </div>

                    <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
                        <a href="{{ path('app_etudiant_groupe_show', {id: groupe.id}) }}" class="btn" style="padding: 0.5rem 1rem;">
                            👁️ Voir détails
                        </a>
                        <a href="{{ path('app_etudiant_groupe_add_member', {id: groupe.id}) }}" class="btn btn-success" style="padding: 0.5rem 1rem;">
                            ➕ Ajouter membre
                        </a>
                        <a href="{{ path('app_etudiant_groupe_edit', {id: groupe.id}) }}" class="btn btn-warning" style="padding: 0.5rem 1rem;">
                            ✏️ Modifier
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}