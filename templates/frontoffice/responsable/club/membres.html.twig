{% extends 'frontoffice/responsable/base.html.twig' %}

{% block title %}Membres du club | SkillOra{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Membres du club</h2>
            <p class="text-muted mb-0">Club : <strong>{{ club.nom }}</strong></p>
        </div>
        <a href="{{ path('responsable_dashboard') }}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if membres is empty %}
        <div class="alert alert-info">Aucun membre dans ce club.</div>
    {% else %}
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Membre</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for membre in membres %}
                            <tr>
                                <td>
                                    <i class="fa fa-user-circle me-2 text-secondary"></i>
                                    {{ membre.fullName }}
                                </td>
                                <td>{{ membre.email }}</td>
                                <td>{{ membre.telephone ?? '—' }}</td>
                                <td class="text-center">
                                    <form method="post" action="{{ path('responsable_club_membre_remove', {userId: membre.id}) }}"
                                          onsubmit="return confirm('Retirer ce membre du club ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_membre' ~ membre.id) }}">
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="fa fa-times me-1"></i>Retirer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}
