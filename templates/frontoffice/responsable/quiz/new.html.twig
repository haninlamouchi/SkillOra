{% extends 'frontoffice/responsable/base.html.twig' %}

{% block title %}Créer un Quiz — {{ formation.titre }} | Skillora Admin{% endblock %}

{% block body %}
<main class="admin-content">
    <div class="container-fluid px-4">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show mt-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Breadcrumb #}
        <div class="mb-4 mt-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-sm mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_formation_index') }}">Formations</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_formation_show', {id: formation.id}) }}">{{ formation.titre }}</a></li>
                    <li class="breadcrumb-item active">Nouveau Quiz</li>
                </ol>
            </nav>
            <h1 class="page-title"><i class="bi bi-patch-question me-2"></i>Créer un Quiz</h1>
            <p class="text-muted mb-0">Formation : <strong>{{ formation.titre }}</strong></p>
        </div>

        {# Quiz Form (Symfony Form) #}
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations du Quiz</h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="row g-3">
                            <div class="col-md-8">
                                {{ form_row(form.titre) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.duree) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.description) }}
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_formation_show', {id: formation.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-skillora px-4">
                                <i class="bi bi-check-lg me-1"></i> Créer le Quiz
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>

                <div class="alert alert-info border-0 shadow-sm">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Étape suivante :</strong> Après la création du quiz, vous pourrez ajouter des questions avec leurs options de réponse.
                </div>
            </div>
        </div>

    </div>
</main>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form');
    if (!form) return;

    var fieldMessages = {
        'quiz_titre':       'Le titre est obligatoire.',
        'quiz_duree':       'La durée est obligatoire.'
    };

    function showError(input, message) {
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        var err = input.parentNode.querySelector('.field-val-error');
        if (!err) {
            err = document.createElement('div');
            err.className = 'field-val-error text-danger small mt-1';
            input.parentNode.appendChild(err);
        }
        err.textContent = message;
        err.style.display = 'block';
    }

    function clearError(input) {
        input.classList.remove('is-invalid');
        input.classList.add('is-valid');
        var err = input.parentNode.querySelector('.field-val-error');
        if (err) err.style.display = 'none';
    }

    Object.keys(fieldMessages).forEach(function(id) {
        var input = document.getElementById(id);
        if (!input) return;
        input.addEventListener('blur', function() {
            if (!this.value.trim()) showError(this, fieldMessages[id]);
            else clearError(this);
        });
        input.addEventListener('input', function() {
            if (this.value.trim()) clearError(this);
        });
    });

    form.addEventListener('submit', function(e) {
        var valid = true;
        var firstInvalid = null;
        Object.keys(fieldMessages).forEach(function(id) {
            var input = document.getElementById(id);
            if (input && !input.value.trim()) {
                showError(input, fieldMessages[id]);
                if (!firstInvalid) firstInvalid = input;
                valid = false;
            }
        });
        if (!valid) {
            e.preventDefault();
            if (firstInvalid) firstInvalid.focus();
        }
    });
});
</script>
{% endblock %}
