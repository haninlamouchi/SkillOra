{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Challenges{% endblock %}

{% block body %}
<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h2>📋 Mes Challenges</h2>
            <p style="color: #718096; margin-top: 0.5rem;">Gérez tous vos challenges</p>
        </div>
        <a href="{{ path('app_responsable_challenge_new') }}" class="btn btn-success">
            ➕ Nouveau Challenge
        </a>
    </div>

    {# BARRE DE RECHERCHE ET TRI #}
    <div style="background: #f7fafc; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
        <form method="get" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: end;">
            <div style="flex: 1; min-width: 250px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748;">
                    🔍 Rechercher
                </label>
                <input type="text" 
                       name="search" 
                       value="{{ search }}" 
                       placeholder="Titre ou description..."
                       style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px;">
            </div>
            
            <div style="min-width: 150px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748;">
                    📊 Trier par
                </label>
                <select name="sort" style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <option value="dateDebut" {% if sortBy == 'dateDebut' %}selected{% endif %}>Date de début</option>
                    <option value="dateFin" {% if sortBy == 'dateFin' %}selected{% endif %}>Date de fin</option>
                    <option value="titre" {% if sortBy == 'titre' %}selected{% endif %}>Titre</option>
                </select>
            </div>
            
            <div style="min-width: 120px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748;">
                    ↕️ Ordre
                </label>
                <select name="order" style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Croissant</option>
                    <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Décroissant</option>
                </select>
            </div>
            
            <div style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.5rem; white-space: nowrap;">
                    Filtrer
                </button>
                <a href="{{ path('app_responsable_challenges') }}" class="btn btn-secondary" style="padding: 0.75rem 1.5rem;">
                    Réinitialiser
                </a>
            </div>
        </form>
    </div>
    
    {# Afficher le nombre de résultats #}
    {% if search %}
        <p style="color: #718096; margin-bottom: 1rem;">
            📊 {{ challenges.getTotalItemCount }} résultat(s) pour "{{ search }}"
        </p>
    {% endif %}

    {% if challenges is empty %}
        <div class="empty-state">
            <div class="icon">📭</div>
            <p>Aucun challenge créé pour le moment</p>
            <a href="{{ path('app_responsable_challenge_new') }}" class="btn">
                Créer votre premier challenge
            </a>
        </div>
    {% else %}
        <div style="display: grid; gap: 1.5rem;">
            {% for challenge in challenges %}
                <div class="challenge-card">
                    <div style="display: flex; justify-content: space-between; align-items: start; gap: 2rem;">
                        <div style="flex: 1;">
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                                <h3 style="color: #2d3748; font-size: 1.4rem; margin: 0;">{{ challenge.titre }}</h3>
                                <span class="badge badge-primary">Actif</span>
                            </div>
                            
                            <p style="color: #718096; margin-bottom: 1rem; line-height: 1.6;">
                                {{ challenge.description|length > 150 ? challenge.description|slice(0, 150) ~ '...' : challenge.description }}
                            </p>
                            
                            <div style="display: flex; gap: 2rem; font-size: 0.9rem; color: #a0aec0; flex-wrap: wrap;">
                                <span style="display: flex; align-items: center; gap: 0.3rem;">
                                    📅 {{ challenge.dateDebut|date('d/m/Y') }}
                                </span>
                                <span style="display: flex; align-items: center; gap: 0.3rem;">
                                    📅 {{ challenge.dateFin|date('d/m/Y') }}
                                </span>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 0.75rem; flex-shrink: 0;">
                            <a href="{{ path('app_responsable_challenge_show', {id: challenge.id}) }}" class="btn" style="padding: 0.75rem 1.25rem; white-space: nowrap;">
                                👁️ Détails
                            </a>
                            <a href="{{ path('app_responsable_challenge_edit', {id: challenge.id}) }}" class="btn btn-warning" style="padding: 0.75rem 1.25rem; white-space: nowrap;">
                                ✏️ Modifier
                            </a>
                            <form method="post" action="{{ path('app_responsable_challenge_delete', {id: challenge.id}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce challenge ?');" 
                                  style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ challenge.id) }}">
                                <button type="submit" class="btn btn-danger" style="padding: 0.75rem 1.25rem; white-space: nowrap;">
                                    🗑️ Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        {# ✨ PAGINATION AJOUTÉE ICI ✨ #}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(challenges, 'pagination/custom_pagination.html.twig') }}
        </div>
        
        {# Statistiques #}
        <div style="margin-top: 2rem; text-align: center; color: #718096;">
            Page {{ challenges.getCurrentPageNumber }} sur {{ challenges.getPageCount }}
            ({{ challenges.getTotalItemCount }} challenge(s) au total)
        </div>
    {% endif %}
</div>
<style>
/* Pagination Style */
.pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0;
}

.pagination li {
    display: inline-block;
}

.pagination li a,
.pagination li span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0.5rem 1rem;
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    color: #4a5568;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
}

.pagination li a:hover {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    border-color: #dc2626;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
}

.pagination li.active span {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    border-color: #dc2626;
    color: white;
    font-weight: 600;
}

.pagination li.disabled span {
    background: #f7fafc;
    border-color: #e2e8f0;
    color: #cbd5e0;
    cursor: not-allowed;
}

.pagination li.previous a,
.pagination li.next a {
    font-weight: 600;
}
</style>
{% endblock %}