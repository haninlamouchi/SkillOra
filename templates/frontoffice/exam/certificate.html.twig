{% extends 'frontoffice/base.html.twig' %}
{% block title %}Certificat — {{ formation.titre }}{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@400;600;700&display=swap');

:root { --gold:#b8860b; --gold-light:#f5d582; --cream:#fffdf4; --ink:#1a1008; }
.sk-page { min-height:100vh; background:#e8e0d0; display:flex; flex-direction:column; align-items:center; padding:100px 20px 60px; }

/* Actions bar */
.cert-actions { display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap; justify-content:center; background:#fff; border-radius:16px; padding:16px 24px; box-shadow:0 4px 20px rgba(0,0,0,0.10); width:100%; max-width:820px; box-sizing:border-box; align-items:center; }
.cert-actions-title { font-family:'DM Sans',sans-serif; font-size:0.82rem; font-weight:600; color:#9a8060; margin-right:auto; }
.sk-btn { display:inline-flex; align-items:center; gap:7px; padding:11px 24px; border-radius:12px; font-weight:700; font-family:'DM Sans',sans-serif; font-size:0.92rem; border:none; cursor:pointer; transition:all .25s; text-decoration:none; }
.sk-btn-gold { background:linear-gradient(135deg,#b8860b,#d4a017); color:#fff; box-shadow:0 3px 12px rgba(184,134,11,.3); }
.sk-btn-gold:hover { transform:translateY(-1px); box-shadow:0 6px 18px rgba(184,134,11,.45); color:#fff; text-decoration:none; }
.sk-btn-ghost { background:#f3f4f6; color:#374151; border:1.5px solid #e5e7eb; }
.sk-btn-ghost:hover { color:#111; text-decoration:none; }

/* Email modal */
.email-modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:999; display:none; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
.email-modal-overlay.open { display:flex; }
.email-modal { background:#fff; border-radius:20px; padding:36px 32px; max-width:440px; width:90%; box-shadow:0 24px 64px rgba(0,0,0,.2); text-align:center; }
.email-modal h3 { font-family:'Bricolage Grotesque',sans-serif; font-size:1.25rem; font-weight:800; color:#1a1008; margin:0 0 8px; }
.email-modal p { font-family:'DM Sans',sans-serif; font-size:0.88rem; color:#6b5540; margin:0 0 20px; line-height:1.5; }
.email-input { width:100%; padding:12px 16px; border:2px solid #e5e7eb; border-radius:12px; font-family:'DM Sans',sans-serif; font-size:0.95rem; outline:none; transition:border-color .2s; box-sizing:border-box; margin-bottom:16px; }
.email-input:focus { border-color:#b8860b; }
.email-modal-btns { display:flex; gap:10px; justify-content:center; }
.email-success { display:none; }
.email-success p { color:#15803d; font-weight:700; font-size:0.95rem; }

/* Certificate */
.certificate-wrap { width:100%; max-width:820px; }
.certificate {
  background: var(--cream);
  border:12px double var(--gold);
  border-radius:8px;
  padding:56px 64px;
  position:relative;
  box-shadow: 0 8px 40px rgba(0,0,0,0.25), inset 0 0 60px rgba(184,134,11,0.05);
  text-align:center;
  font-family:'Playfair Display',serif;
}

/* Corner ornaments */
.certificate::before, .certificate::after {
  content:'❧';
  position:absolute;
  font-size:2.5rem;
  color:var(--gold);
  opacity:.5;
  line-height:1;
}
.certificate::before { top:18px; left:22px; }
.certificate::after  { bottom:18px; right:22px; transform:rotate(180deg); }
.cert-corner-br { position:absolute; top:18px; right:22px; font-size:2.5rem; color:var(--gold); opacity:.5; line-height:1; }
.cert-corner-tl { position:absolute; bottom:18px; left:22px; font-size:2.5rem; color:var(--gold); opacity:.5; line-height:1; transform:rotate(180deg);}

.cert-org {
  font-family:'DM Sans',sans-serif;
  font-size:0.78rem;
  font-weight:700;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:10px;
}
.cert-title {
  font-size:2.8rem;
  font-weight:700;
  color:var(--ink);
  line-height:1.1;
  margin:0 0 6px;
}
.cert-subtitle {
  font-family:'DM Sans',sans-serif;
  font-size:0.9rem;
  color:#7a6648;
  letter-spacing:.08em;
  text-transform:uppercase;
  margin-bottom:32px;
}
.cert-divider {
  width:80px;
  height:3px;
  background:linear-gradient(90deg, transparent, var(--gold), transparent);
  margin:0 auto 28px;
  border:none;
}
.cert-presented {
  font-family:'DM Sans',sans-serif;
  font-size:0.88rem;
  color:#9a8060;
  text-transform:uppercase;
  letter-spacing:.12em;
  margin-bottom:10px;
}
.cert-name {
  font-size:2.2rem;
  font-style:italic;
  color:#5a3e1b;
  margin:0 0 28px;
  line-height:1.15;
}
.cert-body {
  font-family:'DM Sans',sans-serif;
  font-size:0.95rem;
  color:#5a4a2a;
  line-height:1.7;
  max-width:520px;
  margin:0 auto 28px;
}
.cert-formation {
  font-family:'Playfair Display',serif;
  font-size:1.35rem;
  font-weight:700;
  color:var(--ink);
  font-style:italic;
}
.cert-score-row {
  display:flex;
  justify-content:center;
  gap:36px;
  margin:28px 0 32px;
  flex-wrap:wrap;
}
.cert-score-box {
  text-align:center;
}
.cert-score-val {
  font-size:1.8rem;
  font-weight:700;
  color:var(--gold);
  font-family:'Playfair Display',serif;
  line-height:1;
}
.cert-score-lbl {
  font-family:'DM Sans',sans-serif;
  font-size:0.72rem;
  color:#9a8060;
  text-transform:uppercase;
  letter-spacing:.1em;
  margin-top:4px;
}
.cert-seal {
  font-size:4rem;
  margin:0 0 16px;
  display:block;
  filter:drop-shadow(0 4px 8px rgba(184,134,11,0.4));
}
.cert-footer {
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-top:36px;
  padding-top:20px;
  border-top:1px solid rgba(184,134,11,0.25);
  gap:20px;
  flex-wrap:wrap;
}
.cert-footer-col {
  font-family:'DM Sans',sans-serif;
  font-size:0.78rem;
  color:#9a8060;
  text-align:center;
}
.cert-footer-val {
  font-weight:700;
  color:var(--ink);
  font-size:0.88rem;
  margin-top:2px;
}
.cert-sig-line {
  width:120px;
  height:1px;
  background:var(--gold);
  margin:0 auto 4px;
}

/* Print */
@media print {
  .cert-actions, .email-modal-overlay { display:none !important; }
  .sk-page { background:#fff; padding:0; }
  .certificate-wrap { max-width:100%; }
  .certificate {
    border-width:8px;
    box-shadow:none;
    break-inside:avoid;
    padding:40px 50px;
  }
  body { background:#fff; }
  header, footer, nav { display:none !important; }
}
</style>
{% endblock %}

{% block body %}
<div class="sk-page">

  <div class="cert-actions no-print">
    <span class="cert-actions-title">🎓 Votre certificat est prêt</span>
    <button onclick="openEmailModal()" class="sk-btn sk-btn-gold">📥 Télécharger / Envoyer par e-mail</button>
    <a href="{{ path('front_exam_result', {formationId: formation.id, attemptId: attempt.id}) }}" class="sk-btn sk-btn-ghost">← Retour aux résultats</a>
  </div>

  <div class="certificate-wrap">
    <div class="certificate">
      <span class="cert-corner-br">❧</span>
      <span class="cert-corner-tl">❧</span>

      <div class="cert-org">SkillOra — Plateforme de Formation</div>

      <div class="cert-title">Certificat</div>
      <div class="cert-subtitle">de réussite</div>

      <hr class="cert-divider">
      <span class="cert-seal">🎓</span>

      <div class="cert-presented">Ce certificat est décerné à</div>
      <div class="cert-name">{{ app.user ? (app.user.prenom ~ ' ' ~ app.user.nom) : user.prenom ~ ' ' ~ user.nom }}</div>

      <div class="cert-body">
        pour avoir complété avec succès la formation
        <br>
        <span class="cert-formation">« {{ formation.titre }} »</span>
        <br>
        et réussi l'examen final <strong>{{ exam.titre }}</strong>.
      </div>

      <div class="cert-score-row">
        <div class="cert-score-box">
          <div class="cert-score-val">{{ percentage }}%</div>
          <div class="cert-score-lbl">Score obtenu</div>
        </div>
        <div class="cert-score-box">
          <div class="cert-score-val">{{ attempt.score }}/{{ attempt.totalPoints }}</div>
          <div class="cert-score-lbl">Points</div>
        </div>
        <div class="cert-score-box">
          <div class="cert-score-val">{{ attempt.completedAt|date('d/m/Y') }}</div>
          <div class="cert-score-lbl">Date d'obtention</div>
        </div>
      </div>

      <div class="cert-footer">
        <div class="cert-footer-col">
          <div class="cert-sig-line"></div>
          <div>Formation</div>
          <div class="cert-footer-val">{{ formation.titre|slice(0,30) }}{% if formation.titre|length > 30 %}…{% endif %}</div>
        </div>
        <div class="cert-footer-col">
          <div class="cert-sig-line"></div>
          <div>Référence</div>
          <div class="cert-footer-val">CERT-{{ attempt.id|e }}-{{ formation.id|e }}</div>
        </div>
        <div class="cert-footer-col">
          <div class="cert-sig-line"></div>
          <div>Délivré le</div>
          <div class="cert-footer-val">{{ attempt.completedAt|date('d/m/Y') }}</div>
        </div>
      </div>
    </div>
  </div>

</div>

{# Email verification modal #}
<div class="email-modal-overlay" id="emailModal">
  <div class="email-modal">

    <!-- STEP 1 — SEND CODE -->
    <div id="emailForm">
      <div style="font-size:2.5rem;margin-bottom:12px;">📧</div>
      <h3>Vérifier votre e-mail</h3>
      <p>Un code à 6 chiffres sera envoyé à votre adresse e-mail.</p>

      <input type="email" id="emailInput" class="email-input"
             value="{{ app.user ? app.user.email : '' }}"
             placeholder="votre@email.com" readonly>

      <div id="emailError" style="display:none;color:#dc2626;font-family:'DM Sans',sans-serif;font-size:0.82rem;margin:-10px 0 12px;"></div>

      <div class="email-modal-btns">
        <button onclick="closeEmailModal()" class="sk-btn sk-btn-ghost">Annuler</button>
        <button onclick="sendCode()" id="btnSendCode" class="sk-btn sk-btn-gold">📨 Envoyer le code</button>
      </div>
    </div>

    <!-- STEP 2 — VERIFY CODE -->
    <div id="codeForm" style="display:none;">
      <div style="font-size:2.5rem;margin-bottom:12px;">🔑</div>
      <h3>Entrer le code</h3>
      <p id="codeSentMsg" style="font-size:0.88rem;color:#6b5540;margin:0 0 16px;line-height:1.5;"></p>

      <input type="text" id="codeInput" class="email-input"
             placeholder="Code à 6 chiffres" maxlength="6"
             style="text-align:center;font-size:1.5rem;font-weight:800;letter-spacing:.3em;">

      <div id="codeError" style="display:none;color:#dc2626;font-family:'DM Sans',sans-serif;font-size:0.82rem;margin:-10px 0 12px;"></div>

      <div class="email-modal-btns">
        <button onclick="backToEmail()" class="sk-btn sk-btn-ghost">← Retour</button>
        <button onclick="verifyCode()" id="btnVerify" class="sk-btn sk-btn-gold">✓ Vérifier</button>
      </div>
      <p style="margin-top:12px;font-size:0.78rem;color:#9a8060;">
        Pas reçu ? <a href="#" onclick="sendCode();return false;" style="color:#b8860b;font-weight:700;">Renvoyer le code</a>
      </p>
    </div>

  </div>
</div>

<script>
const SEND_CODE_URL   = '{{ path('front_exam_certificate_send_code',   {formationId: formation.id, attemptId: attempt.id}) }}';
const VERIFY_CODE_URL = '{{ path('front_exam_certificate_verify_code', {formationId: formation.id, attemptId: attempt.id}) }}';

function openEmailModal() {
  document.getElementById('emailModal').classList.add('open');
  document.getElementById('emailForm').style.display = 'block';
  document.getElementById('codeForm').style.display  = 'none';
  document.getElementById('emailError').style.display = 'none';
}
function closeEmailModal() {
  document.getElementById('emailModal').classList.remove('open');
}
function backToEmail() {
  document.getElementById('codeForm').style.display  = 'none';
  document.getElementById('emailForm').style.display = 'block';
  document.getElementById('codeInput').value = '';
  document.getElementById('codeError').style.display = 'none';
}

async function sendCode() {
  const btn = document.getElementById('btnSendCode');
  btn.disabled = true;
  btn.textContent = 'Envoi…';
  document.getElementById('emailError').style.display = 'none';

  try {
    const res  = await fetch(SEND_CODE_URL, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const data = await res.json();

    if (data.success) {
      document.getElementById('emailForm').style.display = 'none';
      document.getElementById('codeForm').style.display  = 'block';
      document.getElementById('codeInput').value = '';
      document.getElementById('codeError').style.display = 'none';
      document.getElementById('codeSentMsg').textContent =
        'Code envoyé à ' + data.email + '. Vérifiez votre boîte mail (et les spams).';
      document.getElementById('codeInput').focus();
    } else {
      document.getElementById('emailError').textContent = data.message || 'Erreur lors de l\'envoi.';
      document.getElementById('emailError').style.display = 'block';
    }
  } catch(e) {
    document.getElementById('emailError').textContent = 'Erreur réseau. Réessayez.';
    document.getElementById('emailError').style.display = 'block';
  }

  btn.disabled = false;
  btn.innerHTML = '📨 Envoyer le code';
}

async function verifyCode() {
  const code = document.getElementById('codeInput').value.trim();
  const btn  = document.getElementById('btnVerify');
  const errEl = document.getElementById('codeError');

  if (!code || code.length !== 6) {
    errEl.textContent = 'Entrez le code à 6 chiffres reçu par email.';
    errEl.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Vérification…';
  errEl.style.display = 'none';

  try {
    const res  = await fetch(VERIFY_CODE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();

    if (data.success) {
      closeEmailModal();
      setTimeout(() => window.print(), 200);
    } else {
      errEl.textContent = data.message || 'Code incorrect.';
      errEl.style.display = 'block';
    }
  } catch(e) {
    errEl.textContent = 'Erreur réseau. Réessayez.';
    errEl.style.display = 'block';
  }

  btn.disabled = false;
  btn.textContent = '✓ Vérifier';
}

// Allow pressing Enter in code input
document.getElementById('codeInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') verifyCode();
});

document.getElementById('emailModal').addEventListener('click', function(e) {
  if (e.target === this) closeEmailModal();
});
</script>
{% endblock %}
